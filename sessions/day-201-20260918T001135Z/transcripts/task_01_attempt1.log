```python
# How many adjacent lines a joined window may span when a matcher looks for a shape
# rustfmt has split. ...
REGISTER_JOIN_WINDOW = 4

def _lines_with_joined_windows(lines, window=REGISTER_JOIN_WINDOW):
    """Yield each line, plus the joined text of every window of 2..=`window` adjacent lines.

    A matcher run over this sequence sees a shape rustfmt split across lines AND the
    single-line case unchanged...
    """
    for ln in lines:
        yield ln
    n = len(lines)
    for size in range(2, window + 1):
        for i in range(n - size + 1):
            yield " ".join(l.strip() for l in lines[i:i + size])
```


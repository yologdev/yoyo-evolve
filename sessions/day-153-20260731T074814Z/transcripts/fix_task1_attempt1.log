  + /// Extract a caller-visible turn error from the assistant messages of an
  + /// `AgentEnd`, for the stream-JSON transport.
  + ///
  + /// The interactive path records `StopReason::Error` turns (#646) so callers
  + /// can see them, but the stream-JSON path only ever tracked `InputRejected` —
  + /// so a turn that died with `StopReason::Error` (e.g. tool-call arguments that
  + /// never assembled, or the `pause_turn` shape) was emitted on the wire and
  + /// then exited **0**, reading as a clean success to any script driving
  + /// `--output-format stream-json`. This helper closes that gap.
  + ///
  + /// Returns the last error found. A benign "stream ended" message (#612) is
  + /// deliberately not an error, and non-error stop reasons yield `None`.
  + fn stream_json_turn_error(messages: &[AgentMessage]) -> Option<String> {
  +     let mut found: Option<String> = None;
  +     for msg in messages {
  +         let AgentMessage::Llm(Message::Assistant {
  +             stop_reason,
  +             error_message,
  +             ..
  +         }) = msg

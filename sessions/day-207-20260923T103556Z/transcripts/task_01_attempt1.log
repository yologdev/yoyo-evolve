For `compare_catalogue` signature, use a struct for cleanliness:

```rust
fn compare_catalogue(
    ours: &[(String, (f64, f64, f64, f64))],
    catalogue: &[CatalogueRow],
    rel_tol: f64,
) -> AuditReport {
    let mut report = AuditReport { compared: 0, matched: 0, drifted: Vec::new(), unpriced: Vec::new() };
    for row in catalogue {
        match ours.iter().find(|(id, _)| *id == row.id) {
            None => report.unpriced.push(row.id.clone()),
            Some((_, our)) => {
                report.compared += 1;
                if cells_within(*our, row.price, rel_tol) { report.matched += 1; }
                else { report.drifted.push((row.id.clone(), *our, row.price)); }
            }
        }
    }
    report
}

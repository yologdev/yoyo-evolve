struct AuditReport {
    compared: usize,
    matched: usize,
    drifted: Vec<(String, (f64,f64,f64,f64), (f64,f64,f64,f64))>,
    unpriced: Vec<String>,
}

fn within_tolerance(a: f64, b: f64, rel_tol: f64) -> bool {
    if a == b { return true; }
    let scale = a.abs().max(b.abs());
    if scale == 0.0 { return true; }
    (a - b).abs() / scale <= rel_tol
}
```


    /// The real subprocess, on a well-formed object id no clone contains — the
    /// anti-vacuous half of the named test.
    ///
    /// **Day 207: this fixture used to pin `dcc72f63` and assert it does not
    /// resolve. That assertion was a claim about the *checkout*, not about the
    /// ledger, and it went red.** The ledger stores `git_hash` as an **8-hex
    /// prefix**; a prefix resolves the moment a commit starting with it is
    /// inside the clone's window. Measured today in this 52-commit checkout:
    /// `git cat-file -t dcc72f63` exits 0 and names
    /// `dcc72f6329bdf46b9558365833914f83ded4fc9f` — day 205, ~2 days old — while
    /// on a shallower checkout the same command fails. So the old fixture was
    /// green or red depending on how deep CI happened to fetch, which is the
    /// fixture-reading-ambient-state defect, not the property under test.
    ///
    /// The null oid is the deterministic replacement: well-formed (so it still
    /// shells out rather than short-circuiting like `""`/`"unknown"`) and
    /// absent from every repository, so git fails identically in every clone.
    #[test]
    fn an_absent_object_id_is_unmeasured_not_born_after_end_to_end() {
        // Anti-vacuous, in two parts. (1) The fixture must be well-formed hex,
        // or it would take the sentinel branch and never exercise the
        // subprocess this test exists to cover. (2) The premise itself is
        // asserted: if a clone ever *did* contain the null oid, this test must
        // say so rather than quietly agree with its own fixture.
        assert_eq!(ABSENT_OBJECT_ID.len(), 40, "must be well-formed, not a sentinel");
        assert!(
            ABSENT_OBJECT_ID.chars().all(|c| c.is_ascii_hexdigit()),
            "must be hex, so it is not short-circuited as a sentinel"
        );
        let resolves = crate::git::run_git(&["cat-file", "-t", ABSENT_OBJECT_ID]).is_ok();
        assert!(
            !resolves,
            "{ABSENT_OBJECT_ID} must NOT resolve — if it does, the fixture and \
             the test below have stopped describing the same world"
        );
        let got = git_born_after_at(ABSENT_OBJECT_ID, &paths(&["src/config_paths.rs"]));
        assert!(got.files.is_empty(), "{got:?}");
        assert_eq!(got.unmeasured, paths(&["src/config_paths.rs"]), "{got:?}");
    }

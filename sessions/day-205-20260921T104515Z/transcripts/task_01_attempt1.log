```rust
/// Pure: given the configured value (if any) and the parent's model, the model a child runs on.
fn child_model_from(configured: Option<&str>, parent_model: &str) -> String {
    match configured { None => parent_model.to_string(), Some(c) => c.to_string() }
}

fn resolve_sub_agent_model(store: &OnceLock<Option<String>>, parent_model: &str) -> String {
    child_model_from(store.get().and_then(|m| m.as_deref()), parent_model)
}

pub fn effective_sub_agent_model(parent_model: &str) -> String {
    resolve_sub_agent_model(&SUB_AGENT_MODEL, parent_model)
}
```


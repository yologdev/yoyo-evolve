/// would leave `tests/module_size.rs` green (121 lines of headroom) and clippy
/// green, because two live definitions in two live modules is not an error —
/// it is a duplicate.
///
/// **This is a deliberately weak SOURCE-LEVEL guard and it says so here.**
/// It asserts on definition-shaped *text*: it proves no file under `src/`
/// carries a *definition* of these six names, and it cannot see a duplicate
/// that was renamed, nor one whose body was inlined at a call site. Needles are
/// assembled at runtime so this test cannot match its own source.
#[cfg(test)]
mod module_split_tests {
    use std::path::{Path, PathBuf};

    /// The names #805's receipt listed as still-present (plus `FamilyTally` and
    /// `format_family_line`, which moved with them), spelled as *definitions*
    /// rather than bare names — the parent legitimately *names* three of them in
    /// its re-export and in `FamilyTally::default()` call sites, and a guard on
    /// the bare name would fail on the correct tree.
    fn moved_item_needles() -> Vec<String> {
        [
            ("enum", "Provenance"),
            ("struct", "FamilyTally"),
            ("struct", "ExperimentFamilies"),
            ("fn", "tally_hypothesis_families"),
            ("fn", "format_family_line"),
            ("fn", "format_experiment_families"),
        ]
        .iter()
        .map(|(kind, name)| format!("{kind} {name}"))
        .collect()
    }

    fn collect_rs_files(dir: &Path, out: &mut Vec<PathBuf>) {
        let entries = std::fs::read_dir(dir)
            .unwrap_or_else(|e| panic!("cannot read {}: {e}", dir.display()));
        let mut paths: Vec<PathBuf> = entries.filter_map(|e| e.ok()).map(|e| e.path()).collect();
        paths.sort();
        for path in paths {
            if path.is_dir() {
                collect_rs_files(&path, out);
            } else if path.extension().is_some_and(|e| e == "rs") {
                out.push(path);
            }
        }
    }

    /// Every definition site in the crate, as `(relative path, needle)` pairs.
    fn definition_sites() -> Vec<(String, String)> {
        let root = PathBuf::from(env!("CARGO_MANIFEST_DIR"));
        let mut files = Vec::new();
        collect_rs_files(&root.join("src"), &mut files);

        // Anti-vacuous, in the same shape `tests/module_size.rs` uses: a walk
        // that found nothing would make every assertion below pass silently.
        assert!(
            files.len() > 10,
            "module walk found only {} files — the walk is broken, not the repo",
            files.len()
        );

        let needles = moved_item_needles();
        let mut sites = Vec::new();
        for path in &files {
            let text = std::fs::read_to_string(path)
                .unwrap_or_else(|e| panic!("cannot read {}: {e}", path.display()));
            let rel = path
                .strip_prefix(&root)
                .unwrap_or(path)
                .to_string_lossy()
                .replace('\\', "/");
            for needle in &needles {
                if text.contains(needle.as_str()) {
                    sites.push((rel.clone(), needle.clone()));
                }
            }
        }
        sites
    }

    /// The load-bearing claim: each item is defined exactly once in `src/`, and
    /// the one place is the child module.
    #[test]
    fn each_moved_item_has_exactly_one_definition_and_it_is_in_the_child() {
        let sites = definition_sites();
        let mut wrong: Vec<String> = Vec::new();
        for needle in moved_item_needles() {
            let here: Vec<&String> = sites
                .iter()
                .filter(|(_, n)| *n == needle)
                .map(|(p, _)| p)
                .collect();
            if here.len() != 1 || here[0] != "src/commands_risk_families.rs" {
                wrong.push(format!(
                    "`{needle}` is defined in {here:?} — expected exactly \
                     [\"src/commands_risk_families.rs\"]"
                ));
            }
        }
        assert!(
            wrong.is_empty(),
            "the hypothesis-family extraction is no longer a move:\n  {}\n\n\
             These items live in src/commands_risk_families.rs and are re-exported \
             by src/commands_risk_epistemic.rs. If you are *moving* one back, delete \
             the child's copy in the same commit — a second live definition is a \
             duplicate, not a refactor, and it keeps the size gate green while the \
             parent grows.",
            wrong.join("\n  ")
        );
    }

    /// The near-miss half: the parent must *name* the child, or the child is an
    /// uncompiled orphan and the claim above is about dead text.
    #[test]
    fn the_parent_names_the_child_module() {
        let parent = include_str!("commands_risk_epistemic.rs");
        let main = include_str!("main.rs");
        let use_needle = format!("use crate::{0}::", "commands_risk_families");
        let mod_needle = format!("mod {0};", "commands_risk_families");

        // Anti-vacuous: these pointers really are the files they claim to be.
        assert!(parent.contains("REPORT_TOP_N"), "not the parent module");
        assert!(main.contains("fn main("), "not the crate root");

        assert!(
            parent.contains(use_needle.as_str()),
            "the parent no longer imports the child — every call site would break"
        );
        assert!(
            main.contains(mod_needle.as_str()),
            "src/main.rs does not declare the child module, so rustc never compiles \
             it — cargo build, cargo test, clippy and fmt --check are all blind to it \
             (the Day-173 #804 defect, and tests/orphan_modules.rs guards the same \
             thing at the file level)"
        );
    }
}

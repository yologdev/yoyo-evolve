```python
def convention_census(findings, hunks, vocab=None) -> dict:
    """Measured per-convention counts keyed by the CONVENTION_* constants."""
    vocab = vocab or BUILTIN_VOCABULARY
    counts = {name: 0 for name, _v, _w in WRITTEN_CONVENTIONS}
    hunk_of = {(h.path, h.header): h for h in hunks}
    for f in findings:
        h = hunk_of.get((f.path, f.header))
        if h is None:
            continue
        if f.verdict == MOVED:
            if _is_whole_file_deletion(h.header) and is_dedicated_test_file(h.path):
                counts[CONVENTION_FILE_RENAME] += 1
            elif any(vocab.test_re.search(ln) for ln in h.removed):
                counts[CONVENTION_MODULE_SPLIT] += 1
        elif f.verdict == UNKNOWN:
            r = [ln for ln in h.removed if is_assertion_line(ln, is_dedicated_test_file(h.path), vocab)]
            a = [ln for ln in h.added if is_assertion_line(ln, is_dedicated_test_file(h.path), vocab)]
            if r and len(r) == len(a):
                counts[CONVENTION_CHARACTERIZATION_INVERSION] += 1
        elif f.verdict == WEAKENED:
            if any(REGISTER_ANTIVACUOUS_RE.search(ln) for ln in h.removed):
                counts[CONVENTION_REGISTER_PAYOFF] += 1
    for h in hunks:
        if not is_rust_source(h.path):
            continue
        dedicated = is_dedicated_test_file(h.path)
        if classify_assertion_change(h.removed, h.added, dedicated, vocab) is not None:
            continue
        if any(REGISTER_LITERAL_RE.search(ln) for ln in h.removed + h.added):
            counts[CONVENTION_REGISTER_LINES] += 1
    return counts
```


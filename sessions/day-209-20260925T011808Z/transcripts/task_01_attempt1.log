    # --- Day 209 (#944): a run that never reached its terminal emit ---------
    # Driven through `collect_usage_coverage`, the SAME entry point the real
    # reader calls (#3676) — no private helper, so the fixture exercises the
    # file walk, the boundary and the classifier together, exactly as the
    # session does.
    audit_rec = '{"tool":"bash","duration_ms":20,"success":true}'
    zero_usage = '{"type":"usage","model":"m","input_tokens":0,"output_tokens":0,"cost_usd":0.0}'
    with tempfile.TemporaryDirectory() as tmp:
        root = Path(tmp)
        # A: records, and no terminal emit.  dated AFTER the producer boundary,
        # so this is the state itself and not the pre-producer shape.
        a = root / "day-209-20260925T001500Z"
        a.mkdir()
        (a / "audit.jsonl").write_text(
            "\n".join([audit_rec, audit_rec, '{"tool":"edit_file"}']) + "\n",
            encoding="utf-8",
        )
        # B: the near-miss — a terminal usage record whose tokens are ZERO.
        # An honest zero observed, and it must NOT be reclassified.
        b = root / "day-209-20260925T003000Z"
        b.mkdir()
        (b / "audit.jsonl").write_text(audit_rec + "\n" + zero_usage + "\n", encoding="utf-8")
        # C: same artifact, but BEFORE the boundary — the pre-#848 window's
        # NORMAL shape, so it must demote to not_measurable (rule 4).
        c = root / "day-100-20260601T000000Z"
        c.mkdir()
        (c / "audit.jsonl").write_text(audit_rec + "\n", encoding="utf-8")
        # D: no audit.jsonl at all — unchanged: never counted.
        (root / "day-209-20260925T010000Z").mkdir()
        # E: unparseable — unchanged: could not check.
        e = root / "day-209-20260925T013000Z"
        e.mkdir()
        (e / "audit.jsonl").write_text("not json\n", encoding="utf-8")

        # ANTI-VACUOUS FIRST: the fixture must really carry >=1 record and
        # really carry no usage record, so a matcher broken in the same
        # direction cannot pass this test by agreeing with itself.
        raw_a = (a / "audit.jsonl").read_text(encoding="utf-8")
        assert_true(
            "fixture A really carries records and really lacks a usage record",
            "usage" not in raw_a and raw_a.count("tool") >= 2,
        )
        cov_e = collect_usage_coverage(root)
        assert_eq(
            "records with no terminal emit is its own state, not absent/unreadable",
            f"{cov_e.no_terminal_emit}/{cov_e.absent}/{cov_e.unreadable}/{cov_e.recorded}",
            "1/0/0/1",
        )
        assert_eq(
            "the pre-boundary copy of that artifact still reads not_measurable",
            cov_e.not_measurable,
            1,
        )
        assert_eq(
            "a no-audit.jsonl session is still not counted at all",
            cov_e.examined,
            4,
        )

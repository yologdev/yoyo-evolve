```rust
    // ---- #926: the system-prompt term is MEASURED, not promised ----------

    #[test]
    fn system_prompt_budget_is_measured_from_the_composed_prompt() {
        // ANTI-VACUOUS, ASSERTED FIRST: the fixture must genuinely be the
        // string `build_agent` hands the config. If it is empty, every
        // assertion below is satisfied by having nothing to measure.
        let composed = compose_system_prompt(
            &"You are a reviewer.\n".repeat(50),
            "deepseek",
            "deepseek-v4-flash",
        );
        assert!(
            !composed.is_empty(),
            "ANTI-VACUOUS: the fixture must be a real composed prompt"
        );
        assert!(
            composed.starts_with("You are a reviewer."),
            "the fixture must be the COMPOSED value, not the raw base"
        );

        let window = 200_000usize;
        let (configured, note) = system_prompt_token_budget(&composed, window, true);

        // The value the ContextConfig carries is the estimator's answer on
        // this exact string -- not a constant, and not a second tokenizer.
        assert_eq!(configured, estimate_tokens(&composed));
        assert!(
            note.is_none(),
            "an ordinary prompt must be silent, got: {note:?}"
        );
    }

    #[test]
    fn system_prompt_budget_scales_with_the_prompt() {
        let small = compose_system_prompt("Be terse.", "deepseek", "deepseek-v4-flash");
        let large = compose_system_prompt(&"word ".repeat(8_000), "deepseek", "deepseek-v4-flash");
        let window = 1_000_000usize;

        let (small_tokens, _) = system_prompt_token_budget(&small, window, true);
        let (large_tokens, _) = system_prompt_token_budget(&large, window, true);

        assert_eq!(small_tokens, estimate_tokens(&small));
        assert_eq!(large_tokens, estimate_tokens(&large));
        assert!(
            large_tokens > small_tokens * 10,
            "the configured count must move with the prompt ({small_tokens} -> {large_tokens})"
        );
    }

    #[test]
    fn a_small_prompt_yields_a_small_number_not_a_constant() {
        // The near-miss guard: a discriminator tested only on the side that
        // fires is vacuous green. The old constant was 4_000 and this must
        // NOT reproduce it.
        let small = compose_system_prompt("Be terse.", "deepseek", "deepseek-v4-flash");
        let (tokens, note) = system_prompt_token_budget(&small, 200_000, true);

        assert_eq!(tokens, estimate_tokens(&small));
        assert!(tokens < 100, "a one-line prompt must stay small: {tokens}");
        assert_ne!(tokens, 4_000, "the hardcoded constant must be gone");
        assert!(note.is_none());
    }

    #[test]
    fn over_window_prompt_clamps_and_says_so() {
        // The degenerate case: measured > window. The stated outcome is an
        // honest clamp to the window (never a panic or an unsigned underflow)
        // plus a named note -- `compact_messages` then computes a
        // `saturating_sub` budget of 0, i.e. no room for messages.
        let huge = "x".repeat(4_000_000); // ~1M tokens
        let window = 200_000usize;
        assert!(estimate_tokens(&huge) > window, "fixture must over-shoot");

        let (configured, note) = system_prompt_token_budget(&huge, window, true);
        assert_eq!(configured, window, "must clamp, never wrap or panic");
        let note = note.expect("an over-window prompt must say so");
        assert!(note.contains(&estimate_tokens(&huge).to_string()));
        assert!(note.contains("200000"));
    }

    #[test]
    fn exactly_at_the_window_is_silent() {
        // Boundary pinned on both sides: at the cap -> no note; one over ->
        // note. (The fixture is built so `estimate_tokens` lands exactly on
        // the window: 4 bytes per token.)
        let at = "x".repeat(4_000);
        let window = estimate_tokens(&at);
        let (configured, note) = system_prompt_token_budget(&at, window, true);
        assert_eq!(configured, window);
        assert!(note.is_none(), "at the cap is not over the cap");
    }

    #[test]
    fn over_window_message_is_glyph_free_under_plain_output() {
        let plain = system_prompt_over_window_message(300_000, 200_000, true);
        assert!(plain.is_ascii(), "plain output must be ASCII: {plain}");
        assert!(!plain.contains('\u{2014}'), "no em dash under plain output");

        let rich = system_prompt_over_window_message(300_000, 200_000, false);
        assert!(rich.contains('\u{26a0}') && rich.contains('\u{2014}'));
    }

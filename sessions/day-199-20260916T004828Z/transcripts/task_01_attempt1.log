```rust
pub(crate) fn system_prompt_over_window_message(measured: usize, max: usize, plain: bool) -> String {
    if plain {
        format!(
            "system prompt is ~{measured} tokens but the context window is {max} — nothing left for messages. Reduce the prompt (a large project instruction file is the usual cause) or raise context_window."
        )
    } else {
        format!(
            "⚠ system prompt is ~{measured} tokens but the context window is {max} — no room left for messages.\n  Reduce the prompt (a large project instruction file such as CLAUDE.md is the usual cause) or raise `context_window`."
        )
    }
}
```


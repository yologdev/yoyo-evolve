  + /// Build the message content for a post-compaction overflow retry of a
  + /// content-block prompt.
  + ///
  + /// The text driver (`run_prompt_with_changes`) recovers from a context
  + /// overflow by compacting and re-sending `build_overflow_retry_prompt(input)`.
  + /// The content driver used to refuse, printing "cannot retry with image
  + /// content" — but its user message is *cloned* per attempt, never moved away,
  + /// so the original blocks are still in hand. This prepends the same
  + /// auto-compaction notice the text path uses and preserves every original
  + /// block, in order, so the attachment survives the retry.
  + pub(crate) fn build_overflow_retry_blocks(original: &[Content]) -> Vec<Content> {
  +     // Reuse the text path's wording so the two drivers can't drift apart.
  +     let notice = build_overflow_retry_prompt("").trim_end().to_string();
  +     let mut blocks = Vec::with_capacity(original.len() + 1);
  +     blocks.push(Content::Text { text: notice });
  +     blocks.extend(original.iter().cloned());
  +     blocks
  + }
  + 

    // content". It cannot answer "is the loader CONSULTED at all", because it
    // calls the dir-taking seam directly — the same bypass a naive trust gate
    // would exploit while leaving that detector green. These two guards cover
    // the branch that decides whether the load happens.
    //
    // They are the deliberately WEAK kind this repo already uses for
    // `connect_external_servers` and the MCP pre-flight retry: they read the
    // SOURCE TEXT of the call sites, so they prove the call is still written
    // down and prove nothing about whether it runs.

    /// Read a source file from this crate and return its production half.
    ///
    /// Split at the LAST `mod tests {` rather than the first `#[cfg(test)]`:
    /// `src/commands_spawn.rs` carries three `#[cfg(test)]` markers, two of them
    /// on production functions (a `#[cfg(test)] pub fn` used only by tests), so
    /// splitting at the first would cut the very call site the guard reads.
    fn production_source(file: &str) -> String {
        let path = std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
            .join("src")
            .join(file);
        let src = std::fs::read_to_string(&path)
            .unwrap_or_else(|e| panic!("{} is unreadable: {e}", path.display()));
        let at = src
            .rfind("\nmod tests {")
            .unwrap_or_else(|| panic!("{file} must keep its test module at the end"));
        let production = src[..at].to_string();
        // Anti-vacuous, FIRST: an empty slice satisfies every count below.
        assert!(
            !production.is_empty(),
            "the production slice of {file} must not be empty"
        );
        production
    }

    /// Assemble a needle at runtime so no guard below can be satisfied by its
    /// own source text.
    fn runtime_needle(parts: &[&str]) -> String {
        parts.concat()
    }

    /// Body of the block opened by `header`, by brace counting.
    /// Returns `None` if the braces never balance — a guard that cannot read its
    /// input must not read as "clean".
    fn block_after<'a>(src: &'a str, header: &str) -> Option<&'a str> {
        let start = src.find(header)? + header.len();
        let mut depth = 1usize;
        for (i, ch) in src[start..].char_indices() {
            match ch {
                '{' => depth += 1,
                '}' => {
                    depth -= 1;
                    if depth == 0 {
                        return Some(&src[start..start + i]);
                    }
                }
                _ => {}
            }
        }
        None
    }
```


```rust
fn reading(&self, hash: &str, surprises: &[String]) -> LedgerBornAfter {
    let sentinel = |s: &[String]| -> LedgerBornAfter {
        let members: Vec<(String, bool)> = s.iter().map(|p| (p.clone(), false)).collect();
        git_born_after_by_check(false, &members)
    };
    if hash.is_empty() || hash == "unknown" { return sentinel(surprises); }
    if self.resolves.get(hash) != Some(&true) { return sentinel(surprises); }
    let mut members = Vec::with_capacity(surprises.len());
    for p in surprises {
        match self.exists.get(&(hash.to_string(), p.clone())) {
            Some(exists) => members.push((p.clone(), *exists)),
            // A pair the resolver never probed: the check is incomplete for this
            // row, so it is unmeasured — never "did not exist".
            None => return sentinel(surprises),
        }
    }
    git_born_after_by_check(true, &members)
}
```


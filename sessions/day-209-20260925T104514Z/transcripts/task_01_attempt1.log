```rust
/// Resolve the git readings the retrospective git leg needs: for every row's
/// own `snapshot_git_hash`, whether it resolves in this clone, and for each of
/// that row's surprises whether the path existed at that hash.
///
/// Unresolvable hashes are **skipped explicitly** — the clone here is shallow
/// (`git rev-parse --is-shallow-repository` is `true`), so some snapshot hashes
/// cannot be resolved, and the honest reading for those rows is `unmeasurable`,
/// never "nothing was born late". Nothing here deepens the clone, renames a
/// remote or fetches: the answer for an unresolvable hash is `unmeasurable` and
/// the count is printed.
pub(crate) fn resolve_git_readings(rows: &[SurpriseRow]) -> GitReadings {
    let mut out = GitReadings::default();
    for row in rows {
        let hash = row.snapshot_git_hash.as_str();
        if hash.is_empty() || hash == "unknown" || out.seen(hash) { continue; }
        let resolves = crate::git::run_git(&["cat-file", "-t", hash]).is_ok();
        if !resolves { out.mark_unresolved(hash); continue; }
        out.mark_resolved(hash);
        for p in &row.surprises {
            let spec = format!("{hash}:{p}");
            let exists = crate::git::run_git(&["cat-file", "-e", &spec]).is_ok();
            out.set_exists(hash, p, exists);
        }
    }
    out
}
```


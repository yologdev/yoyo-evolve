impl GitReadings {
    /// One row's git reading, through the **same predicate** the live path uses
    /// ([`git_born_after_by_check`]) — this struct supplies the probe results,
    /// it does not re-decide what "born after" means.
    fn reading(&self, hash: &str, surprises: &[String]) -> LedgerBornAfter {
        if hash.is_empty() || hash == "unknown" {
            let members = sentinel_members(surprises);
            return git_born_after_by_check(false, &members);
        }
        match self.resolves.get(hash) {
            Some(true) => {
                let members: Vec<(String,bool)> = surprises.iter()
                    .map(|p| (p.clone(), *self.exists.get(&(hash.to_string(), p.clone())).unwrap_or(&false)))
                    .collect();
                git_born_after_by_check(true, &members)
            }
            _ => { // unresolved or never probed — both are "the check did not run"
                let members = sentinel_members(surprises);
                git_born_after_by_check(false, &members)
            }
        }
    }
}
```


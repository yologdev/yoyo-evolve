```rust
/// Every `task.status_changed` payload naming `task_id`, in file order.
fn task_status_changes(state_dir: &Path, task_id: &str) -> Vec<serde_json::Value> {
    domain_events(state_dir)
        .into_iter()
        .filter(|(k, p)| {
            k == "task.status_changed"
                && p.pointer("/task_id/0").and_then(|i| i.as_str()) == Some(task_id)
        })
        .map(|(_, p)| p)
        .collect()
}
```


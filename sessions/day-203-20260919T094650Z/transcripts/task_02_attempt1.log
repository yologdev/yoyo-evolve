```rust
/// #915 slice 2 — the no-op shape...
async fn abandon_task<S: EventStore>(
    state: &YoAgentState<S>,
    actor: &ActorRef,
    run_id: &str,
    num: &str,
    reason: &str,
) -> Result<(), StateError> {
    let task_id = task_node_id(run_id, num);
    // `update_task_status` appends `task.status_changed` BEFORE it can return an
    // error, so an `if let Err(..)` around it cannot protect against a missing
    // node — the check must be on the CALL (#849). ...
    if state.get_node(NodeId::new(task_id.as_str())).await.is_none() {
        eprintln!("gasp: task node {task_id} does not exist — ...");
        return Ok(());
    }
    state.update_task_status(TaskId::new(task_id), TaskStatus::Abandoned, Some(reason.to_string())).await?;
    Ok(())
}
```


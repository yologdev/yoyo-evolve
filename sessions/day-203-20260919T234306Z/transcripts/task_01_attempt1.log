```rust
/// What distinguishes yoyo's two dispatch tools from each other: the name the
/// parent model sees and the sentence it is given about the tool. Everything
/// else — provider wiring, child tool set assembly, the one fallback retry, the
/// diagnostic wrapper — is the *same code*, because two spellings of one policy
/// is the "two doors, one policy, one deaf" shape this repo has already shipped
/// six times.
struct DispatchFlavor {
    name: &'static str,
    description: &'static str,
}

const SUB_AGENT_FLAVOR: DispatchFlavor = DispatchFlavor {
    name: "sub_agent",
    description: "Delegate a subtask to a fresh sub-agent with its own context window. \
             Use for complex, self-contained subtasks like: researching a codebase, \
             running a series of tests, or implementing a well-scoped change. \
             The sub-agent has bash, file read/write/edit, list, and search tools. \
             The sub-agent also has its own sub_agent tool and may delegate further, \
             bounded to a hard nesting cap (recursion is available and finite). \
             It starts with a clean context and returns a summary of what it did.",
};

/// The read-only dispatcher's parent-facing description.
///
/// It states the narrowing AND what the narrowing means in tool names, because
/// the Day-181 third-door defect is exactly this: a model that cannot see a
/// capability does not conclude *that tool is missing*, it concludes **the
/// capability does not exist** and works around it. So the sentence says what
/// is removed, that it was removed *on purpose*, and what the child still has —
/// including the two limits, stated rather than left to be discovered: `bash`
/// survives (this is a narrowing, not a sandbox) and the child is a leaf.
const EXPLORE_AGENT_FLAVOR: DispatchFlavor = DispatchFlavor {
    name: EXPLORE_AGENT_TOOL_NAME,
    description: "Delegate a READ-ONLY exploration subtask to a fresh sub-agent ...",
};
```


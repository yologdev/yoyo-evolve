    pub fn run_post_failure_hooks(
        &self,
        tool_name: &str,
        params: &serde_json::Value,
        error: &str,
    ) -> Option<String> {
        let mut notes: Vec<String> = Vec::new();
        for hook in &self.hooks {
            match hook.post_failure(tool_name, params, error) {
                Ok(Some(stderr)) => if !stderr.trim().is_empty() { notes.push(stderr) },
                Ok(None) => {}
                Err(reason) => notes.push(format!("post_failure hook `{}` did not run: {reason}", hook.name())),
            }
        }
        if notes.is_empty() { None } else { Some(notes.join("\n")) }
    }
```


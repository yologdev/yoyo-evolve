New:
```rust
/// Phase at which a shell hook fires.
///
/// Three phases, and the config-key spelling is the *single* source of truth:
/// [`HookPhase::ALL`] and [`HookPhase::as_str`] are read by the parser, the
/// `/hooks` listing, the project-trust refusal message and the unknown-phase
/// warning, so a fourth phase cannot be added in one place and forgotten in
/// another. One spelling everywhere: the enum variant, the `.yoyo.toml` key
/// segment, the docs and the tests.
#[derive(Debug, Clone, Copy, PartialEq)]
pub enum HookPhase {
    /// Before the tool call.
    Pre,
    /// After a tool call, **successful or not** — a `Pre`-blocked call never
    /// reaches here.
    Post,
    /// After a tool call that **failed**, i.e. a call whose inner tool returned
    /// `Err`. This is the one event `Post` structurally cannot see: `Post` runs
    /// on the wrapper's success path, and a failing tool returns early, so
    /// before Day 202 a failed call ran **no** post-hook at all.
    ///
    /// Claude Code spells this lifecycle event `PostToolUseFailure`. yoyo's
    /// config vocabulary has an opinion (`pre` / `post` — short, lowercase
    /// segments of `hooks.<phase>.<tool>`), so the key here is
    /// `hooks.post_failure.<tool>` and the origin is recorded rather than
    /// borrowed: a second spelling would be the "two doors, one policy" shape
    /// this repo keeps shipping.
    PostFailure,
}

impl HookPhase {
    /// Every phase, in the order they fire for a single call. **This const is
    /// the accepted set** — no second copy of it exists.
    pub const ALL: [HookPhase; 3] = [HookPhase::Pre, HookPhase::Post, HookPhase::PostFailure];

    /// The `.yoyo.toml` key segment for this phase. One spelling everywhere.
    pub fn as_str(self) -> &'static str {
        match self {
            HookPhase::Pre => "pre",
            HookPhase::Post => "post",
            HookPhase::PostFailure => "post_failure",
        }
    }

    /// Parse a `hooks.<phase>.<tool>` key segment. `None` for anything not in
    /// [`HookPhase::ALL`].
    pub fn parse(segment: &str) -> Option<HookPhase> {
        HookPhase::ALL.into_iter().find(|p| p.as_str() == segment)
    }
}
```


    /// Run all post-failure hooks. A failure-hook's own failure is **reported,
    /// never substituted**: the tool's `Err` is the fact the model needs, so the
    /// hook errors are returned alongside it rather than replacing it.
    pub fn run_post_failure_hooks(
        &self,
        tool_name: &str,
        params: &serde_json::Value,
        error: &str,
    ) -> Vec<String> {
        let mut failures = Vec::new();
        for hook in &self.hooks {
            if let Err(reason) = hook.post_failure(tool_name, params, error) {
                failures.push(format!("{}: {reason}", hook.name()));
            }
        }
        failures
    }

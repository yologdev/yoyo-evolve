/// under a known phase (`hooks.pre.bash = "..."`) or as a `[hooks...]`
/// section header? Read by the project-trust prompt (`config_paths.rs`), which
/// cannot call `parse_hooks_from_config` because it only has the raw text.
pub fn config_text_names_a_hook(config_text: &str) -> bool {
    config_text.lines().any(|line| {
        let t = line.trim_start();
        t.starts_with("[hooks")
            || HookPhase::ALL
                .iter()
                .any(|p| t.starts_with(&format!("hooks.{}.", p.as_str())))
    })
}
```


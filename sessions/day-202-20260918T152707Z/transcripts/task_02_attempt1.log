```rust
#[derive(Debug, Clone, PartialEq, Eq)]
struct Mention { symbol: String, line: usize }

fn rust_symbol_mentions(md: &str) -> Vec<Mention> {
    let mut out = Vec::new();
    for (idx, line) in md.lines().enumerate() {
        if line.matches('`').count() % 2 != 0 { continue; }   // unpaired ticks: skip the line
        let mut parts = line.split('`');
        parts.next();
        let mut inside = true;
        for part in parts {
            if inside && is_rust_symbol_shaped(part) {
                out.push(Mention { symbol: part.to_string(), line: idx + 1 });
            }
            inside = !inside;
        }
    }
    out
}
```

Hmm — `line.matches('`').count()` counts non-overlapping matches of a char = number of ticks. Good.


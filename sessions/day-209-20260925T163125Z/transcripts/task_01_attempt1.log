Test 2: behavioural.

```rust
    /// BEHAVIOURAL, through the real registry and the real `ShellHook`: a blocking
    /// pre-hook's own stderr reaches the caller — and therefore the agent, since
    /// `maybe_hook` wraps this exact string as `Blocked by hook: {reason}`.
    #[tokio::test]
    async fn blocking_pre_hook_reports_its_stderr() {
        let mut registry = HookRegistry::new();
        registry.register(Box::new(ShellHook {
            name: "pre:bash".to_string(),
            phase: HookPhase::Pre,
            tool_pattern: "*".to_string(),
            command: "echo 'run cargo fmt first' >&2; exit 3".to_string(),
        }));
        let err = registry
            .run_pre_hooks("bash", &serde_json::json!({}))
            .expect_err("a non-zero pre-hook must block");
        assert!(err.contains("exited with code 3"), "{err}");
        assert!(err.contains("run cargo fmt first"), "{err}");

        // NEAR-MISS TWIN: the same exit code with NO output must render exactly the
        // pre-existing message. This is the row that makes the change additive
        // rather than a rewrite — the common silent-blocking hook is untouched.
        let mut silent = HookRegistry::new();
        silent.register(Box::new(ShellHook {
            name: "pre:bash".to_string(),
            phase: HookPhase::Pre,
            tool_pattern: "*".to_string(),
            command: "exit 3".to_string(),
        }));
        let err = silent
            .run_pre_hooks("bash", &serde_json::json!({}))
            .expect_err("a non-zero pre-hook must block");
        assert_eq!(err, "Pre-hook 'pre:bash' exited with code 3");
    }
```

Note the hook name registered gets prefixed on parse, but here we construct directly with "pre:bash" which is what the task specifies.


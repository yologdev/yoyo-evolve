    if m is None:
        return DocFreshness(state=DOC_FRESH_COULD_NOT_CHECK, reason=f"no `Last verified: Day N` header in {GAP_DOC_REL_PATH}")
    try:
        verified = int(m.group(1))
    except ValueError:

def classify_doc_freshness(gap_text: str, day_text: str) -> DocFreshness:
    """Pure half: header + day counter -> a state. No I/O, no clock.

    A header that does not parse is a REFUSAL, not a zero: a missing `Last
    verified` line means the file makes a currency claim nothing can date, and
    rendering that as "fresh" is the "could not check must not read as checked;
    clean" defect this repo has now fixed in `collision_guard_skipped_message`
    and `resolve_audit_dir`.
    """

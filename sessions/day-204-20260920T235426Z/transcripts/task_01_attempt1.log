```python
def collect_doc_freshness(root: Path) -> DocFreshness:
    """I/O half, at ONE call site. Two reads, nothing else."""
    try:
        gap_text = (root / GAP_DOC_REL_PATH).read_text(errors="replace")
    except OSError as e:
        warn(f"could not read {GAP_DOC_REL_PATH}: {e}")
        return DocFreshness(state=DOC_FRESH_COULD_NOT_CHECK, reason=f"could not read {GAP_DOC_REL_PATH}")
    try:
        day_text = (root / DAY_COUNT_REL_PATH).read_text(errors="replace")
    except OSError as e:
        warn(f"could not read {DAY_COUNT_REL_PATH}: {e}")
        return DocFreshness(state=DOC_FRESH_COULD_NOT_CHECK, reason=f"could not read {DAY_COUNT_REL_PATH}")
    return classify_doc_freshness(gap_text, day_text)
```

Render:

```python
def render_doc_freshness(f: DocFreshness) -> str:
    """At most 2 lines, header included. Renders on the FRESH path too, ...

    THE STATED LIMIT IS IN THE RENDERED TEXT: this dates the header, never the
    body — the rows below the header were last read on Day 74 and nothing here
    re-verifies one of them.
    """
    if f.state == DOC_FRESH_COULD_NOT_CHECK:
        return (
            f"## Doc freshness: not checked — {f.reason}. "
            f"This is NOT 'the gap analysis is current'."
        )
    line = (
        f"{GAP_DOC_REL_PATH}: header verified day-{f.verified_day}, "
        f"{f.age_days} day(s) old (day {f.current_day})"
    )
    if f.state == DOC_FRESH_STALE:
        line += (
            f" — STALE (>{DOC_STALE_AFTER_DAYS} days). The body has NOT been "
            f"re-verified; re-read a row before trusting it."
        )
    else:
        line += f" — within the {DOC_STALE_AFTER_DAYS}-day threshold."
    return "## Doc freshness: the header, not the body" + "\n" + line
```


    use yoagent::agent::Agent;
    use yoagent::*;
  + 
  + /// Strip a command prefix and trim whitespace from user input.
  + ///
  + /// This is the canonical way to extract arguments from a `/command` input string.
  + /// If `input` starts with `prefix`, the prefix is removed and the remainder is trimmed.
  + /// Otherwise returns an empty string.
  + ///
  + /// # Examples
  + /// ```ignore
  + /// cmd_arg("/diff --staged", "/diff")   // => "--staged"
  + /// cmd_arg("/diff", "/diff")            // => ""
  + /// cmd_arg("something else", "/diff")   // => ""
  + /// ```
  + pub fn cmd_arg<'a>(input: &'a str, prefix: &str) -> &'a str {
  +     input.strip_prefix(prefix).unwrap_or("").trim()
  + }
    

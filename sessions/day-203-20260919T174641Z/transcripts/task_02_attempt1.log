```rust
    /// **The link Day 194 traced and never observed, and the one the two-door
    /// reading of this socket leaves open:** the real seam reads
    /// `cli_config::is_safe_mode()`, while `--restricted` turns that global on
    /// through a path that does not go through `spawn_project_context_with` at
    /// all (`cli.rs`'s `restricted_mode_effects` sets `Config.safe_mode`, and
    /// `main.rs` copies it into the global). So the pure tests below and the
    /// source-level guard above are both green on a tree where a **restricted**
    /// parent's worker still receives project context — which is why this test
    /// drives the wrapper itself rather than the pure half.
    ///
    /// Both flags are covered by real CLI runs as well, recorded in
    /// ARCHITECTURE.md: from a directory carrying a CLAUDE.md with a unique
    /// marker, `--print-system-prompt` carries the marker with no flag and
    /// carries none under either `--safe-mode` or `--restricted`, and a real
    /// prompt run prints `--safe-mode`'s own banner under both. That was a
    /// manual reading; this is the gate.
    ///
    /// `#[serial]` and a deliberate `set_safe_mode(false)` warm-up because this
    /// is the one test in the file that writes a process-global: starting from
    /// the documented default makes it independent of what ran before it in the
    /// same binary. The only read that can race is the trap row's, so it is
    /// retried a bounded number of times with a no-op — never asserted in the
    /// flaky direction (see `REGISTER_DRIFT_GRACE_LINES`'s class in
    /// `tests/module_size.rs` for why one flake is worth more than the
    /// assertion it buys).
    #[test]
    #[serial]
    fn a_restricted_parent_confines_its_worker_through_the_real_global() {
        // Pure half first: anti-vacuous, because if safe mode did not suppress
        // the load the trap row below would pass by agreeing with itself.
        let payload = "# Project Instructions\n\nunique-marker\n";
        let load = || Some(payload.to_string());
        assert_eq!(
            spawn_project_context_with(false, &load),
            Some(payload.to_string()),
            "anti-vacuous: without safe mode the seam must return the loader's value"
        );
        assert_eq!(
            spawn_project_context_with(true, &load),
            None,
            "anti-vacuous: safe mode must suppress the loader"
        );

        // Warm a cold path without asserting anything about it (it may
        // legitimately be None or Some in this repo).
        crate::cli_config::set_safe_mode(false);
        let _ = spawn_project_context();

        // Row 1 — neither flag: byte-identical to the loader's own value. Every
        // user who has passed neither flag, and the whole regression surface.
        let plain = spawn_project_context();
        let plain_expected = spawn_project_context_with(false, &|| crate::cli::load_project_context());
        assert_eq!(
            plain, plain_expected,
            "with neither flag the worker's context must be exactly the loader's value"
        );

        // Row 2 — a `--restricted` parent (the global `--restricted` sets via
        // `main.rs`): the worker gets nothing, and the loader is not reached.
        crate::cli_config::set_safe_mode(true);
        let mut confined = spawn_project_context();
        for _ in 0..5 {
            if confined.is_none() {
                break;
            }
            confined = spawn_project_context();
        }
        assert_eq!(
            confined, None,
            "a --restricted parent must hand its worker no project context"
        );
    }
```


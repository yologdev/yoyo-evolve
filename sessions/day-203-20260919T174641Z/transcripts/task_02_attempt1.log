/// The DOOR CENSUS — a deliberately weak source-level guard, and its own doc
/// comment says which claim it does not make.
///
/// The two-slice guard above covers `handle_spawn` and `handle_spawn_bg`. It
/// does NOT cover `handle_spawn_parallel` (its slice ends before that
/// function), nor any fourth `/spawn` entry point a later session might add.
/// Rather than enumerate entry points — a list that goes stale the moment one
/// is added — this pins the property that makes enumeration unnecessary:
/// `crate::cli::load_project_context()` is reachable from exactly ONE place in
/// this file, the safe-mode seam, so every handler that wants project context
/// must go through it. A second raw call site anywhere in the file reddens
/// this test, including in a handler that does not exist yet (#902).
#[test]
fn the_raw_loader_has_exactly_one_call_site_in_this_file_and_it_is_the_seam() {
    let src = include_str!("commands_spawn.rs");
    // Needles assembled at runtime so this test cannot satisfy itself from its
    // own source (the raw string would otherwise appear right here).
    let raw = format!("crate::cli::load_project_{}()", "context");
    let seam_fn = format!("fn spawn_project_{}()", "context");

    // Anti-vacuous FIRST: the needle must really match something, or the
    // exact-count assertion below could pass over a file that never loaded
    // project context at all — i.e. by there being nothing to gate.
    let hits: Vec<usize> = src.match_indices(&raw).map(|(i, _)| i).collect();
    assert_eq!(
        hits.len(),
        1,
        "fixture/needle drift: expected exactly one raw loader call in this file, found {}. \
         Two means a handler bypasses --safe-mode; zero means the needle no longer matches \
         and this guard is vacuous.",
        hits.len()
    );

    // And it is the seam's, not some handler's: the one hit must sit inside
    // `spawn_project_context()`, the single global read the safe-mode decision
    // wraps. A hit anywhere else means a door outside the seam.
    let seam_at = src
        .find(&seam_fn)
        .unwrap_or_else(|| panic!("source-level guard drift: no `{seam_fn}` in this file"));
    assert!(
        hits[0] > seam_at,
        "the raw loader call must sit inside the seam wrapper, not above it"
    );
    ...
}
```


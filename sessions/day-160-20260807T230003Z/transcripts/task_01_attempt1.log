    pub(crate) const SESSION_TOOL_CALL_CAP: usize = 200;
  + 
  + // ---------------------------------------------------------------------------
  + // Deterministic-refusal stems (#662)
  + // ---------------------------------------------------------------------------
  + // Guard wrappers refuse deterministically: the same call gets the same answer
  + // every time, so auto-retry must not burn its budget re-asking. These stems
  + // are the single definition of each refusal message's recognisable core —
  + // the wrappers below format their errors FROM them, and
  + // `prompt_retry::is_deterministic_tool_error` matches ON them, so a reword
  + // cannot desync guard and classifier.
  + 
  + /// Core of `SessionCapTool`'s refusal message.
  + pub(crate) const SESSION_CAP_REFUSAL_STEM: &str = "session cap reached";
  + /// Core of `ReadModeGuardTool`'s refusal messages while `/read` is on.
  + pub(crate) const READ_MODE_REFUSAL_STEM: &str = "read mode is active";
  + /// Core of `ReadModeGuardTool`'s refusal messages while `/plan` is on.
  + pub(crate) const PLAN_MODE_REFUSAL_STEM: &str = "plan mode is active";

  + /// Classification of a finished assistant turn for retry purposes.
  + ///
  + /// Day 91 lesson: retrying harder is wrong for permanent failures. This enum
  + /// makes the permanent/transient distinction explicit and testable.
  + #[derive(Debug, Clone, Copy, PartialEq, Eq)]
  + pub enum StopClass {
  +     /// The model refused the request (`StopReason::Refusal`, yoagent 0.9).
  +     /// PERMANENT: never auto-retry or auto-continue — the user must rephrase.
  +     Refused,
  +     /// Context overflow — the caller should compact and retry once.
  +     Overflow,
  +     /// Transient API error (rate limit, 5xx, network) — retry with backoff.
  +     Retriable,
  +     /// Normal completion, or a non-retriable error that is surfaced but not retried.
  +     Done,
  + }

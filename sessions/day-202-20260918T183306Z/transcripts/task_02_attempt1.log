    /// Deliberately **weak** source-level guard, and its limit is stated rather than
    /// implied: this proves each member of the two vocabulary consts still appears as
    /// a quoted `match` arm inside the handler it claims to mirror. It does NOT prove
    /// the CLI guard fires, and it does not prove the const is COMPLETE — a new arm
    /// whose word was never added would keep this test green.
    #[test]
    fn arg_vocabulary_consts_name_real_match_arms() {
        for (const_name, marker, vocabulary) in [
            ("TEACH_ARGS", "fn handle_teach(", TEACH_ARGS),
            ("ARCHITECT_ARGS", "fn handle_architect(", ARCHITECT_ARGS),
        ] {
            // Anti-vacuous first: an empty const would make the loop below a
            // silent pass, which is exactly the failure this test exists to catch.
            assert!(
                !vocabulary.is_empty(),
                "{const_name} is empty — it would gate nothing and the loop below \
                 would be vacuous"
            );
            let body = slice_fn_body(include_str!("commands_config.rs"), marker);
            for arg in vocabulary {
                // Assembled at runtime so this test cannot satisfy itself by
                // matching its own source text.
                let needle = format!("\"{arg}\"");
                assert!(
                    body.contains(&needle),
                    "{const_name} names {needle}, which is not a match arm of {marker} — \
                     the const has drifted from the handler it mirrors"
                );
            }
        }
    }

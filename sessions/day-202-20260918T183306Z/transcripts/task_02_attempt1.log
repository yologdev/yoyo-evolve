```rust
    /// Slice one function body out of this module's own source, from its `fn`
    /// marker to the first closing brace at column zero.
    fn slice_fn_body(src: &str, marker: &str) -> &str {
        let start = src
            .find(marker)
            .unwrap_or_else(|| panic!("{marker} not found in this file"));
        let rest = &src[start..];
        let end = rest.find("\n}\n").expect("unterminated function body");
        let body = &rest[..end];
        assert!(
            body.len() < src.len() / 4,
            "the slice from {marker} swallowed too much of the file — the marker \
             matched something other than the function"
        );
        body
    }

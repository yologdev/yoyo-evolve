    # 6. Defensive reads: the JSON is written by a shell script.
    assert_eq(
        "junk counters degrade to zero, never crash",
        count_task_reverts(
            [{"tasks_attempted": "two", "tasks_succeeded": None}, {}]
        ),
        (0, 0, 0),
    )
    assert_eq(
        "succeeded > attempted never goes negative",
        count_task_reverts([outcome(1, 3)]),
        (0, 0, 0),
    )

    # 6b. The ABSENT-KEY DEFAULT, decided and pinned rather than left to be
    #     inferred from `lost`: an older outcome dict with no `reverted` key
    #     carries no record of a session-level revert, so it lands in the
    #     unresolved population and never in the reverted one. The fixture is
    #     asserted anti-vacuously to REALLY lack the key, so a typo cannot make
    #     this row pass by agreeing with itself.
    ABSENT = {"tasks_attempted": 2, "tasks_succeeded": 1}
    assert_true(
        "anti-vacuous: the absent-key fixture really lacks `reverted`",
        "reverted" not in ABSENT,
    )
    assert_eq(
        "an absent `reverted` key defaults to NOT reverted → unresolved",
        count_task_reverts([ABSENT]),
        (0, 1, 1),
    )

    # 6c. Anti-vacuous on the other side: the fixtures that are supposed to
    #     carry the key really do, and carry the value the row claims.
    assert_true(
        "anti-vacuous: the fixtures carry the `reverted` values the rows claim",
        all("reverted" in o for o in GREEN + NO_VERDICT + FLAGGED)
        and [o["reverted"] for o in FLAGGED] == [True, False, True]
        and any(o["reverted"] is False for o in NO_VERDICT),
    )

    # 6d. The populations are DISJOINT — each session is in exactly one of the
    #     two task populations, so nothing is double-counted and nothing is lost.
    assert_eq(
        "the two task populations partition the sessions that carry a signal",
        count_task_reverts(BOTH),
        (1, 1, 1),
    )

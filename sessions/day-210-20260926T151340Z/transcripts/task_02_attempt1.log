Now render_reverts:

```python
def render_reverts(reverts: int, outcomes: list[dict]) -> str:
    """Report the revert signals as distinct named things — never summed.

    Three populations, not two, and none of them summed: a whole-session revert
    COMMIT (build failure after the session, the `reverted` flag), a task lost
    with that flag SET (per-task resets, no commit), and a task lost with the
    flag UNSET — which is not a revert at all until the artifact says so. That
    third one is the state `session_row_note` already names with
    NO_VERDICT_NOTE, and reusing that constant is the point: one state, one name.
    """
    total_sessions = len(outcomes)
    if total_sessions == 0:
        return ""
    reverted_tasks, unresolved_tasks, reverted_sessions, unresolved_sessions = (
        count_task_reverts(outcomes)
    )
    # The clean window is every window with nothing to report — including a
    # window whose only signal is a no-verdict task, which must NOT render the
    # all-clear line above (it would hide the population this function exists to
    # name). Unchanged for a project with neither signal: byte-identical.
    if reverted_tasks == 0 and unresolved_tasks == 0 and reverts == 0:
        return (
            "## Reverts in window\n"
            f"0 task reverts in last ~{total_sessions} sessions, "
            f"0 whole-session revert commits in {WINDOW_DAYS} days."
        )
    lines = ["## Reverts in window"]
    if reverted_tasks:
        lines.append(
            f"{reverted_tasks} task(s) reverted across {reverted_sessions} of the "
            f"last ~{total_sessions} sessions (per-task resets, no commit)."
        )
    else:
        lines.append(f"0 task reverts in last ~{total_sessions} sessions.")
    if unresolved_tasks:
        lines.append(
            f"{unresolved_tasks} task(s) {NO_VERDICT_NOTE} across "
            f"{unresolved_sessions} of the last ~{total_sessions} sessions."
        )
    lines.append(
        f"{reverts} whole-session revert commit(s) in last {WINDOW_DAYS} days."
    )
    return "\n".join(lines)
```


```rust
/// Table rows the *source* never mentions — the direction the comparator above
/// structurally cannot see.
///
/// `ours_from_catalogue` builds its list **from** the catalogue, so every row it
/// hands `compare_catalogue` is by construction a row the source carried: a table
/// arm models.dev says nothing about never enters the comparison at all, and a
/// silent omission is exactly the shape this alarm exists to refuse — *a detector
/// reports the leaks it happens to trigger and certifies nothing by its silence*.
/// So the audited population is enumerated from the repo's own side, and the ids
/// the source does not carry are named with a count.
///
/// **The population's bound is stated rather than implied: it is the ids
/// `providers::known_models_for_provider` ships for [`PROVIDER_KEYS`]**, which is
/// the repo's single authority for "a model id we support". Arms priced by a
/// `contains` match that no provider table lists (the Day-204 alarm's
/// `UNAUDITED_DEEPSEEK_ARMS` are exactly those) are outside this enumeration and
/// are reported by that alarm instead, not quietly counted as audited here.
struct Unaudited {
    /// `provider/id` labels of shipped ids no catalogue row maps to.
    ids: Vec<String>,
    /// How many shipped ids the question was asked of. Reported so an empty
    /// answer cannot be confused with an empty question.
    examined: usize,
}

/// Which of the table's own shipped ids the source never mentions.
fn unaudited_shipped_rows(catalogue: &[CatalogueRow]) -> Unaudited {
    let mut ids = Vec::new();
    let mut examined = 0usize;
    for provider in PROVIDER_KEYS {
        for shipped in crate::providers::known_models_for_provider(provider) {
            examined += 1;
            let carried = catalogue.iter().any(|candidate| {
                candidate.provider == *provider
                    && yoyo_id_for(candidate.provider.as_str(), &candidate.id) == Some(*shipped)
            });
            if !carried {
                ids.push(format!("{provider}/{shipped}"));
            }
        }
    }
    Unaudited { ids, examined }
}
```


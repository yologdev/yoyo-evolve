#[test]
fn estimated_arms_are_audited_by_the_same_path_with_no_skip_set() {
    // The ids whose table arms carry an `(estimated)` comment. The point is
    // behavioural, not textual: a hand-listed skip set keyed on that marker
    // would show up here as an arm that reports `compared == 0`, so this pins
    // that they reach the SAME comparator as every verified row.
    let estimated = [
        ("openai", "gpt-5"),
        ("openai", "gpt-5-mini"),
        ("openai", "codex-mini"),
        ("google", "gemini-3.0-pro"),
        ("google", "gemini-3.0-flash"),
        ("xai", "grok-4"),
        ("xai", "grok-4-mini"),
        ("groq", "llama-4-maverick-17b"),
    ];
    assert!(!estimated.is_empty(), "an empty list would make this vacuous");
    for (provider, yoyo_id) in estimated {
        let ours = price_of(yoyo_id)
            .unwrap_or_else(|| panic!("the table must still price `{yoyo_id}`"));
        // Perturb the table's OWN reading rather than a literal, so this stays
        // true whichever number is eventually verified: the assertion is about
        // the function's output, never about the table being wrong.
        let perturbed = (ours.0 * 3.0, ours.1, ours.2, ours.3);
        let catalogue = vec![row(provider, yoyo_id, perturbed)];
        let our_side = ours_from_catalogue(&catalogue);
        assert_eq!(
            our_side.len(),
            1,
            "`{provider}/{yoyo_id}` did not map to a shipped id — the fixture is not \
             exercising the arm it names"
        );
        let report = compare_catalogue(&our_side, &catalogue, REL_TOL);
        assert_eq!(report.compared, 1, "`{yoyo_id}` was skipped, not compared");
        assert_eq!(
            report.drifted.len(),
            1,
            "a 3x repricing of the `(estimated)` arm `{yoyo_id}` was NOT reported — an \
             `(estimated)` arm must go through the same path as every verified row"
        );
    }
}
```


/// Which prompt door refused a slash command.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
enum PromptDoor {
    /// `echo "/risk" | yoyo` — the piped/stdin door.
    Piped,
    /// `yoyo -p "/risk"` — the `--prompt` door.
    SinglePrompt,
}

/// Build the refusal shown when a prompt looks like a slash command.
///
/// Returns `None` when `input` does not look like one, so both doors share the
/// single predicate `looks_like_slash_command`...
fn slash_command_refusal(input: &str, door: PromptDoor) -> Option<String> {
    if !looks_like_slash_command(input) {
        return None;
    }
    Some(match door {
        PromptDoor::Piped => format!(
            "{YELLOW}yoyo: slash commands aren't available in piped mode.{RESET}\n  Try one of:\n    yoyo doctor                    # run a subcommand directly\n    yoyo --prompt \"{input}\"        # send the literal text to the agent\n    yoyo                           # interactive REPL\n"
        ),
        PromptDoor::SinglePrompt => format!(
            "{YELLOW}yoyo: slash commands aren't available with --prompt.{RESET}\n  Try one of:\n    yoyo                           # interactive REPL (slash commands work here)\n    yoyo doctor                    # run a subcommand directly\n  Note: a prompt that merely starts with \"/\" is treated as a command — rephrase it (e.g. drop the leading slash) if you meant it literally.\n"
        ),
    })
}
```


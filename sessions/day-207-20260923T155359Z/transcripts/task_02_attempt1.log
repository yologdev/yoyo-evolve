def load_claim_sessions(audit_dir: Path) -> list[ClaimSession]:
    ours = []
    for name, data in iter_session_outcomes(audit_dir):
        got = data.get("tasks_succeeded", 0)
        if isinstance(got, bool) or not isinstance(got, int) or got < 0:

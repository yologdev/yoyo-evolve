```python
def compact_utc_epoch(stamp) -> int | None:
    """Pure: the epoch second of a compact Zulu stamp ... None for anything
    else, so a malformed stamp stays UNKNOWN rather than being coerced."""
    s = compact_utc_stamp(stamp)   # also accepts ISO? no: compact_utc_stamp normalises both shapes
    if s is None: return None
    try:
        dt = datetime.strptime(s, "%Y%m%dT%H%M%SZ")
    except ValueError:
        return None
    return int(dt.replace(tzinfo=timezone.utc).timestamp())
```

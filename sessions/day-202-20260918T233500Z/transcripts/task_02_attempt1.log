    /// #913: the CLI door narrows `gasp::RecorderPlan`'s three-state decision to
    /// `Open` by construction. This pins that narrowing to the one branch it can
    /// produce, so a future widening of `required()` (an `--state-dir ""` that
    /// starts being accepted, say) cannot silently reopen the other two without
    /// someone noticing — the failure mode the call-site comment above
    /// `run_gasp_command`'s `plan_from_env_values` call exists to prevent.
    ///
    /// This is a property of the SHARED function as seen from THIS door, not a
    /// restatement of `src/gasp.rs`'s own Disabled/Misconfigured coverage: those
    /// rows hand the function `None`/empty inputs directly, which this door can
    /// never do.
    #[test]
    #[cfg(feature = "gasp")]
    fn gasp_cli_door_narrows_the_plan_to_open() {
        use crate::gasp::{plan_from_env_values, RecorderPlan, DEFAULT_GOAL};

        // Anti-vacuous first: if either fixture value were empty the `Open`
        // table below would be asserting against the very branch it claims is
        // unreachable, and a transcription slip would make the test pass by
        // agreeing with itself.
        let states = ["yoyo-gasp", ".yoyo/gasp-store", "/tmp/state"];
        let goals = ["goal_self_improvement", "goal_abc123"];
        for value in states.iter().chain(goals.iter()) {
            assert!(
                !value.trim().is_empty(),
                "fixture value {value:?} is empty — the table below would be vacuous"
            );
        }

        // The load-bearing clause: `goal_id` is non-empty only because the
        // fallback is. An empty DEFAULT_GOAL would quietly make this door's
        // `Misconfigured` path live, which is exactly what the narrowing
        // asserts cannot happen.
        assert!(
            !DEFAULT_GOAL.trim().is_empty(),
            "DEFAULT_GOAL is empty, so this door's goal argument can be empty after all"
        );

        // PRESENCE: every realistic pair this door can build is `Open`.
        for state in states {
            for goal in goals {
                assert_eq!(
                    plan_from_env_values(Some(state), Some(goal)),
                    RecorderPlan::Open {
                        root: std::path::PathBuf::from(state),
                        goal_id: goal.to_string(),
                    },
                    "state-dir {state:?} + goal {goal:?} must open"
                );
                // The door's real goal value comes from `unwrap_or_else(DEFAULT_GOAL)`,
                // not from the fixture above.
                assert_eq!(
                    plan_from_env_values(Some(state), Some(DEFAULT_GOAL)),
                    RecorderPlan::Open {
                        root: std::path::PathBuf::from(state),
                        goal_id: DEFAULT_GOAL.to_string(),
                    },
                    "the DEFAULT_GOAL fallback must still open"
                );
            }
        }

        // The non-vacuity near-miss, and the whole claim: the `Misconfigured`
        // branch exists and is only UNREACHABLE THROUGH THIS DOOR. If this row
        // fails, the defect is not the one #913 describes and the right move is
        // to say so rather than adjust the test.
        for blank in ["", "   "] {
            assert_eq!(
                plan_from_env_values(Some(blank), Some(DEFAULT_GOAL)),
                RecorderPlan::Misconfigured(format!(
                    "{} is set but {} is not — no goal to chain runs to",
                    crate::gasp::STATE_DIR_ENV,
                    crate::gasp::GOAL_ID_ENV
                )),
                ...

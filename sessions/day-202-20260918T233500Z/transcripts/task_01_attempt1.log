Then the renderer:

```rust
/// Render the whole `/mcp list` body.
///
/// Extracted pure so a test can assert the full block byte-for-byte — in
/// particular that **the no-failure case is unchanged**, which is every user
/// whose servers all connect. `handle_mcp`'s only job is to print the result.
///
/// The only per-row difference a failure makes is the marker from
/// [`mcp_failure_marker`]; the header, the row columns and the aggregate tail
/// are byte-identical to before.
pub(crate) fn mcp_list_text(
    cli_servers: &[String],
    server_configs: &[crate::cli::McpServerConfig],
    mcp_count: u32,
    mcp_failed: &[String],
    plain: bool,
) -> String {
    if cli_servers.is_empty() && server_configs.is_empty() {
        return format!(
            "  No MCP servers configured.\n\n  Add servers to .yoyo.toml:\n    [mcp_servers.myserver]\n    command = \"npx\"\n    args = [\"-y\", \"@modelcontextprotocol/server-fetch\"]\n\n  See /mcp help for more details.\n"
        );
    }
    let mut out = String::from("  MCP Servers:\n");
    for cfg in server_configs {
        let full_cmd = if cfg.args.is_empty() {
            cfg.command.clone()
        } else {
            format!("{} {}", cfg.command, cfg.args.join(" "))
        };
        let marker = mcp_failure_marker(
            mcp_failed,
            &crate::agent_builder::mcp_failed_server_id(&cfg.name, &cfg.command),
            plain,
        )
        .unwrap_or_default();
        out.push_str(&format!("    {:<14}{}{marker}\n", cfg.name, full_cmd));
    }
    for cmd in cli_servers {
        let label = cmd.split_whitespace().next().unwrap_or("unknown");
        let marker = mcp_failure_marker(mcp_failed, cmd, plain).unwrap_or_default();
        out.push_str(&format!("    {:<14}{cmd}{marker}\n", label));
    }
    let total = cli_servers.len() + server_configs.len();
    out.push('\n');
    if mcp_count > 0 {
        out.push_str(&format!(
            "  {total} server(s) configured, {mcp_count} connected\n"
        ));
    } else {
        out.push_str(&format!("{}\n", mcp_not_connected_message(total)));
    }
    out
}
```


```rust
/// The identifier `record_failed_server` records for a `[mcp_servers.*]` entry
/// that failed to connect.
///
/// One definition, two call sites: the `Err` arm of the structured-MCP connect
/// loop (the writer) and `/mcp list` (the reader that marks the row). Two copies
/// of this format string would agree the day they are written and diverge the
/// first time one is reworded — and that failure is silent: the row simply
/// stops being marked, and nothing else notices.
pub(crate) fn mcp_failed_server_id(name: &str, command: &str) -> String {
    format!("{name} ({command})")
}

Plan for code:

```rust
/// Warn when the user's configured `max_tokens` exceeds the ceiling the
/// resolved model config declares.
///
/// Pure and table-tested, so the exact string is pinned at the emission point
/// and `None` for the ordinary case (config <= ceiling) is the whole
/// regression surface.
pub(crate) fn max_tokens_ceiling_warning(
    configured: u32,
    ceiling: u32,
    model: &str,
    plain: bool,
) -> Option<String> {
    if configured <= ceiling {
        return None;
    }
    let marker = if plain { "" } else { "⚠ " };
    Some(format!(
        "{marker}configured max_tokens {configured} exceeds {model}'s declared ceiling \
{ceiling}; the provider may reject the request. Lower max_tokens or pick a model that \
allows it."
    ))
}
```


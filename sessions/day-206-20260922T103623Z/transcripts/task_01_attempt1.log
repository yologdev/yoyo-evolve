Implementation:
```rust
pub(crate) fn count_unhittable_surprises(
    surprises: &[String],
    snapshot_ts: &str,
    first_scored: &std::collections::BTreeMap<String, String>,
    founding: Option<&str>,
) -> UnhittableCount {
    let mut out = UnhittableCount { unhittable: 0, measured: 0, unmeasurable: 0 };
    // An unknown snapshot ts can decide nothing: without a time to compare
    // against, every surprise is unmeasurable — never "hittable".
    if snapshot_ts == "unknown" {
        out.unmeasurable = surprises.len() as u32;
        return out;
    }
    for path in surprises {
        match first_scored_age(path, first_scored, founding) {
            // The ledger's ts and the snapshot's ts are both fixed-width
            // ISO-8601 UTC (`%Y-%m-%dT%H:%M:%SZ`), so lexicographic order is
            // chronological order — a plain string compare is the date compare.
            Some(ts) if ts > snapshot_ts => {
                out.unhittable += 1;
                out.measured += 1;
            }
            // Born at or before the snapshot: it existed to be predicted, so
            // this is a real miss and counts as measured (hittable).
            Some(_) => out.measured += 1,
            // Founding-batch or never-scored: no birthday to compare.
            None => out.unmeasurable += 1,
        }
    }
    out
}
```


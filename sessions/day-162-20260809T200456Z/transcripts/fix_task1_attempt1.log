  + /// Drop paths the risk model can never score from a classified breakage set.
  + ///
  + /// The CLI `yoyo risk validate` grading path (`handle_risk_validate`) feeds
  + /// `classify_broke_files` output into `compute_validation`, whose surprise list
  + /// becomes the graded denominator. `classify_broke_files` returns *every* file
  + /// touched by a repair-claiming commit — including `Cargo.toml`,
  + /// `journals/JOURNAL.md`, `dreams/experiments.jsonl` — none of which the scorer
  + /// can ever rank, so each one was a guaranteed miss inflating the denominator.
  + ///
  + /// Uses the same `is_scoreable_path` predicate as the other two grading sites in
  + /// `commands_risk_snapshots.rs`; all three must agree.
  + fn scoreable_broke_files(
  +     broke: std::collections::HashSet<String>,
  + ) -> std::collections::HashSet<String> {
  +     broke
  +         .into_iter()
  +         .filter(|f| crate::commands_risk_snapshots::is_scoreable_path(f))
  +         .collect()
  + }
  + 

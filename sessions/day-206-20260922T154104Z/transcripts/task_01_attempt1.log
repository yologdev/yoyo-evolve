pub(crate) fn retrospective_unhittable(
    rows: &[RetrospectiveRow],
    first_scored: &BTreeMap<String,String>,
    founding: Option<&str>,
) -> RetrospectiveCount {
    let mut out = RetrospectiveCount::default();
    let Some(founding) = founding else { return out };  // no ledger start → nothing post-ledger
    for row in rows {
        if row.ts.as_str() <= founding { continue; }   // strict: ties excluded
        out.population += 1;
        let mut saw_unhittable = false;
        let mut saw_unmeasurable = false;
        for path in &row.surprises {
            match verdict_for(path, first_scored, founding, &row.ts) {
                Unhittable => saw_unhittable = true,
                Unmeasurable => saw_unmeasurable = true,
                Hittable => {}
            }
        }
        if saw_unhittable { out.rows_with_unhittable += 1; }
        if saw_unmeasurable { out.rows_with_unmeasurable += 1; }
    }
    out
}
```


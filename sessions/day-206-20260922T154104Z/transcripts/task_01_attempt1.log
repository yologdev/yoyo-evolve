```rust
/// One historical grading event, reduced to what the retrospective join reads.
///
/// The live path reads a snapshot (whose `ts` is the boundary); a historical
/// row has no resolvable snapshot — its `snapshot_git_hash` cannot be checked
/// out in this shallow clone — so the boundary is the event's **own** `ts`,
/// which is the first-scored-ledger join the dream named as the fallback.
#[derive(Debug, Clone, PartialEq, Eq)]
pub(crate) struct RetrospectiveRow {
    /// The event's own timestamp — the boundary a member is compared against.
    pub(crate) ts: String,
    /// The files this event named as surprises.
    pub(crate) surprises: Vec<String>,
}

/// The retrospective reading: a count with its denominator, over the events the
/// ledger can actually grade.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
pub(crate) struct RetrospectiveCount {
    /// Post-ledger grading events: rows whose own `ts` is strictly after the
    /// first-scored ledger's founding `ts`.
    pub(crate) population: u32,
    /// Rows carrying >= 1 surprise first scored after that row's own `ts`.
    pub(crate) rows_with_unhittable: u32,
    /// Rows carrying >= 1 surprise the join could not decide.
    pub(crate) rows_with_unmeasurable: u32,
}

/// The three states of a retrospective reading — never folded.
#[derive(Debug, Clone, PartialEq, Eq)]
pub(crate) enum RetrospectiveReading {
    /// The ledger was read and the population measured (which may be zero).
    Counted(RetrospectiveCount),

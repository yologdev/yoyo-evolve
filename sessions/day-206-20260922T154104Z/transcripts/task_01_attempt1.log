pub(crate) fn retrospective_unhittable_note(reading: &RetrospectiveReading, plain: bool) -> Option<String> {
    let body = match reading {
        RetrospectiveReading::Counted(c) if c.population == 0 => "unhittable: no post-ledger grading events yet (not the same as zero unhittable)".to_string(),
        RetrospectiveReading::Counted(c) => format!("unhittable: {} of {} post-ledger grading events carried a file first scored after the event",
            c.rows_with_unhittable, c.population),
        RetrospectiveReading::Unreadable(err) => format!("unhittable: first-scored ledger could not be read ({err}) — this is unknown, not zero"),
    };
    Some(if plain { body } else { format!("📊 {body}") })
}

```rust
    /// #942 — the model id and the provider resolve independently, so an id that
    /// belongs to another vendor's family is invisible: the request simply goes to
    /// the wrong endpoint and the 401 arrives before anything else. The warning is
    /// emitted once, at resolution time, and names the endpoint — the one fact the
    /// user cannot otherwise see.
    #[test]
    fn test_model_provider_mismatch_warns_once_and_is_silent_on_every_other_shape() {
        const FOREIGN_ID: &str = "claude-fable-5-1";
        // ANTI-VACUOUS: the fixture really is one whose inferred family disagrees
        // with the resolved provider, so the `Some` row cannot pass by having
        // quietly become a row that returns `None`.
        let inferred = crate::prompt_retry::infer_provider_from_model(FOREIGN_ID);
        assert_eq!(inferred, "anthropic");
        assert_ne!(inferred, "deepseek");

        // (model, provider, base_url_given, must_warn)
        let rows = [
            (FOREIGN_ID, "deepseek", false, true),      // the issue's own case
            ("deepseek-v4-flash", "deepseek", false, false), // my loop's pair
            ("totally-unknown-model", "deepseek", false, false), // never guess
            (FOREIGN_ID, "deepseek", true, false),      // explicit --base-url
            ("claude-opus-5", "openrouter", false, false), // aggregator
            ("", ...)
        ];
        for (model, provider, base_url_given, must_warn) in rows {
            let got = model_provider_mismatch_warning(model, provider, base_url_given);
            assert_eq!(got.is_some(), must_warn, "...");
        }
        // The warning names the endpoint requests will actually go to.
        let w = model_provider_mismatch_warning(FOREIGN_ID, "deepseek", false).unwrap();
        assert!(w.contains(FOREIGN_ID));
        assert!(w.contains("'deepseek'"));
        assert!(w.contains("https://api.deepseek.com/v1"));
        // full-string pin for the silent rows: `None`, not "no output contains".
        assert_eq!(model_provider_mismatch_warning("deepseek-v4-flash", "deepseek", false), None);
        assert_eq!(model_provider_mismatch_warning("totally-unknown-model", "deepseek", false), None);
        assert_eq!(model_provider_mismatch_warning(FOREIGN_ID, "deepseek", true), None);
        assert_eq!(model_provider_mismatch_warning("claude-opus-5", "openrouter", false), None);
        assert_eq!(model_provider_mismatch_warning("claude-opus-5", "bogus-provider", false), None);
    }
```


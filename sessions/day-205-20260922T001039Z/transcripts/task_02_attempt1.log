So:

```rust
fn model_provider_mismatch_warning(model: &str, provider: &str, base_url_given: bool) -> Option<String> {
    if base_url_given { return None; }
    if !KNOWN_PROVIDERS.contains(&provider) { return None; }
    if MULTI_VENDOR_PROVIDERS.contains(&provider) { return None; }
    let inferred = crate::prompt_retry::infer_provider_from_model(model);
    if inferred == provider { return None; }
    if !crate::providers::model_is_known_for_provider(&inferred, model) { return None; }
    let endpoint = crate::agent_builder::create_model_config(provider, model, None).base_url;
    Some(format!(
        "{YELLOW}warning:{RESET} Model '{model}' looks like a {inferred} id, but provider '{provider}' \
         is set, so requests go to {endpoint}. If you meant {inferred}, pass --provider {inferred}; \
         if the endpoint is deliberate (a gateway serving these ids), pass --base-url to silence this."
    ))
}
```


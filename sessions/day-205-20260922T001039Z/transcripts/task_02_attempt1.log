```rust
pub(crate) fn model_provider_mismatch_warning(
    model: &str,
    provider: &str,
    base_url_given: bool,
) -> Option<String> {
    if base_url_given {
        return None;
    }
    let provider = provider.to_ascii_lowercase();
    if !SINGLE_VENDOR_PROVIDERS.contains(&provider.as_str()) {
        // Gateways, aggregators and local runtimes serve other vendors' ids on
        // purpose, and an unrecognised provider name is already warned about.
        return None;
    }
    let inferred = infer_provider_from_model(model);
    if inferred == provider {
        return None;
    }
    // `infer_provider_from_model` has no "I don't know" answer: an id matching
    // nothing comes back as "anthropic" (its own safe default). So a family is
    // only treated as a claim when the inferred provider actually publishes that
    // id — true for the Claude fleet, false for the fallback.
    if !crate::providers::model_is_known_for_provider(&inferred, model) {
        return None;
    }
    let endpoint = crate::agent_builder::create_model_config(&provider, model, None).base_url;
    Some(format!(
        "{YELLOW}warning:{RESET} Model '{model}' looks like an {inferred} model, but provider \
         '{provider}' is in use: requests will go to {endpoint}. Use --provider {inferred}, or \
         --base-url if that endpoint serves this model."
    ))
}
```


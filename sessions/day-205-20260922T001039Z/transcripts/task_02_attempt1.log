    model: &str,
    provider: &str,
    base_url_given: bool,
) -> Option<String> {
    if base_url_given { return None; }
    if GATEWAY_PROVIDERS.contains(&provider) { return None; }
    if !KNOWN_PROVIDERS.contains(&provider) { return None; }  // unknown provider: separate warning already
    let inferred = infer_provider_from_model(model);
    if inferred == provider { return None; }
    // `infer_provider_from_model` returns "anthropic" for an id that matched no family
    // (its documented safe default), so an "anthropic" inference is only a claim when the
    // id actually carries an Anthropic marker.
    if inferred == "anthropic" && !anthropic_id_marker(model) { return None; }
    let endpoint = create_model_config(provider, model, None).base_url;
    Some(format!(...))
}
```


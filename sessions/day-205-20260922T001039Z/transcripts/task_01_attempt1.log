/// Is `model` a known model id for `provider`?
///
/// True when the provider's diagnostic list contains the id exactly, or — for
/// the Anthropic provider only — when the fleet preset lookup that the
/// model-config path actually uses resolves it. One resolution rule, not two:
/// `anthropic_preset` is prefix-based, so `claude-fable-5-1` and dated ids
/// like `claude-opus-5-20260724` are the same model, and the "Unknown model"
/// warning must not contradict the config that got built.
///
/// Provider-scoped on purpose: a preset-resolvable Claude id under a *different*
/// provider (e.g. `provider = "deepseek"`) is not resolved by that provider's
/// path and must still warn.
pub(crate) fn model_is_known_for_provider(provider: &str, model: &str) -> bool {
    if known_models_for_provider(provider).contains(&model) {
        return true;
    }
    provider == "anthropic" && crate::agent_builder::anthropic_preset(model).is_some()
}
```


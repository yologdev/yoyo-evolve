```rust
/// The `Unknown model` warning for a genuinely unknown id, or `None`.
///
/// Pure and table-tested at the emission point: the string returned here is
/// the string the caller prints, byte for byte — the existing wording
/// (`Proceeding anyway (custom models are valid).`) is read by other tests
/// and by user habit, so it is unchanged.
pub(crate) fn unknown_model_warning(provider: &str, model: &str) -> Option<String> {
    if crate::providers::model_is_known_for_provider(provider, model) {
        return None;
    }
    let known = known_models_for_provider(provider);
    if known.is_empty() {
        return None;
    }
    Some(format!(
        "{YELLOW}warning:{RESET} Unknown model '{model}' for provider '{provider}'. \
         Known models: {}. Proceeding anyway (custom models are valid).",
        known.iter().take(5).copied().collect::<Vec<_>>().join(", ")
    ))
}
```


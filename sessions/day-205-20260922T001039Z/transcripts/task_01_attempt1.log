```rust
/// Whether `model` is a known id for `provider`.
///
/// One matching rule, consulted by every surface that asks "is this id
/// known?" — the startup warning in `cli.rs` and the preset lookup in
/// `agent_builder.rs` must not disagree, because they take the same input
/// (#941: `--model claude-fable-5-1` resolved to the Fable preset, priced
/// correctly, and still warned `Unknown model` on every turn).
///
/// The rule is the union of two sources and it is **provider-scoped**:
/// the provider's own suggested list, or — for `anthropic` only — the
/// fleet preset table in `crate::agent_builder::anthropic_preset`, which
/// is prefix-matched so a dated or suffixed id (`claude-haiku-4-5-20251001`,
/// `claude-fable-5-1`) resolves. The prefix list is never copied here;
/// it is read through the same lookup the model-config path uses.
///
/// The scoping is the half that matters: a Claude id under
/// `provider = "deepseek"` is NOT known, and must keep warning — the
/// preset is Anthropic's, so resolving it under another provider would
/// turn a true positive into a false negative.
pub fn model_is_known_for_provider(provider: &str, model: &str) -> bool {
    let known = known_models_for_provider(provider);
    if !known.is_empty() && known.contains(&model) {
        return true;
    }
    provider == "anthropic" && crate::agent_builder::anthropic_preset(model).is_some()
}
```


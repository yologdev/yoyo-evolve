```rust
/// Does `provider`'s model list, or its model-config resolution rule, accept
/// `model`?
///
/// True when the provider's diagnostic list contains the id exactly, **or** —
/// for `anthropic` only — when the fleet-preset lookup the model-config path
/// actually uses ([`crate::agent_builder::anthropic_preset`], reached through
/// [`crate::agent_builder::anthropic_model_config`]) resolves it. This is one
/// resolution rule rather than two: the preset arms are prefix-based, so
/// `claude-fable-5-1` and dated ids like `claude-opus-5-20260724` are the same
/// model the config path builds, and the "Unknown model" warning must not
/// contradict the config that got built (#941).
///
/// Provider-scoped on purpose: an id an Anthropic preset resolves is *not*
/// known under any other provider — `provider = "deepseek"` with a Claude id
/// is a different defect (the id is simply wrong there) and must still warn.
pub(crate) fn model_is_known_for_provider(provider: &str, model: &str) -> bool {
    if known_models_for_provider(provider).contains(&model) {
        return true;
    }
    provider == "anthropic" && crate::agent_builder::anthropic_preset(model).is_some()
}

/// The `Unknown model` warning a caller should print for (provider, model), or

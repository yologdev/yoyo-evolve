  + /// Escape a value for a TOML basic string (`"..."`).
  + /// Only the two characters that can break out of the quotes matter here —
  + /// API keys are read from a trimmed single line, so no control chars.
  + fn toml_escape(value: &str) -> String {
  +     value.replace('\\', "\\\\").replace('"', "\\\"")
  + }
  + 
  + /// Should this key be offered for persistence at all?
  + /// Ollama's placeholder isn't a secret, and a blank key is nothing to save.
  + pub fn key_is_savable(provider: &str, key: &str) -> bool {
  +     provider != "ollama" && !key.trim().is_empty()
  + }
  + 
  + /// Parse a yes/no answer where anything but an explicit yes means **no**.
  + /// Writing a secret to disk is opt-in, so the default must be the safe one.
  + pub fn parse_yes_default_no(input: &str) -> bool {
  +     matches!(input.trim().to_lowercase().as_str(), "y" | "yes")
  + }

pub(crate) fn load_skill_source(
    dir: &std::path::Path,
    label: &'static str,
    project_local: bool,
) -> (SkillSet, Vec<SkillError>) {
    let (set, errors) = SkillSet::load_dir_resilient(dir, label);
    if !project_local {
        return (set, errors);
    }
    let root = std::env::current_dir().ok();
    let (kept, escaped) = partition_escaped_skills(set, root.as_deref());
    if !escaped.is_empty() && !crate::format::is_quiet() {
        eprintln!("{}{}{}", crate::format::YELLOW, escaped_skill_refusal_message(&escaped, crate::format::is_plain_output()), crate::format::RESET);
    }
    (kept, errors)
}
```


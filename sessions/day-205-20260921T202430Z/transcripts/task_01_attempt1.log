```rust
/// The cap on a refused path interpolated into the escape message.
///
/// The target is chosen by whoever authored the project-local symlink, i.e. it is
/// repository-authored text reaching a terminal — the same provenance as the
/// strings `cli.rs` already escapes. Capped on a **char** boundary (#250), never a
/// raw byte index.
const SKILL_ESCAPE_PATH_MAX_BYTES: usize = 200;

/// Why a project-local skill directory was refused.
#[derive(Debug, Clone, PartialEq, Eq)]
pub(crate) enum SkillEscape {
    /// The directory resolved to a real path outside the project root.
    Outside { resolved: std::path::PathBuf },
    /// The directory could not be resolved at all. Refused rather than assumed
    /// safe: "could not check" must not read as "checked; inside".
    Unresolvable { base_dir: std::path::PathBuf },
}

/// Whether a project-local skill directory escapes `canon_root`.
///
/// `None` means "inside the root" — the common case and the only one that loads.
/// Two non-escaping cases matter and one of them is the near-miss control: a plain
/// directory inside the root, and a **symlink from one in-project directory to
/// another** (which resolves *inside* the root). An "is it a symlink" predicate
/// would refuse the second, and refusing an in-project symlink is a false positive
/// that breaks real users, so the predicate is "escapes the root", never "is a link".
pub(crate) fn skill_dir_escape(base_dir: &std::path::Path, canon_root: &std::path::Path) -> Option<SkillEscape> {
    match std::fs::canonicalize(base_dir) {
        Ok(resolved) => {
            if resolved.starts_with(canon_root) {
                None
            } else {
                Some(SkillEscape::Outside { resolved })
            }
        }
        Err(_) => Some(SkillEscape::Unresolvable {
            base_dir: base_dir.to_path_buf(),
        }),
    }
}

/// Split loaded project-local skills into the ones inside the project root and the
/// ones that escaped it (or could not be resolved).
///
/// `canon_root: None` means the project root itself could not be resolved, so the
/// comparison is inapplicable and **nothing is filtered** — the loader behaves
/// exactly as it did before this check existed. Stated rather than implied: an
/// unresolvable root is the one branch where the check cannot run, and it is a
/// pathological state (a deleted or unreadable cwd) rather than a quiet default.
pub(crate) fn partition_escaped_skills(
    skills: Vec<yoagent::skills::Skill>,
    canon_root: Option<&std::path::Path>,
) -> (Vec<yoagent::skills::Skill>, Vec<(String, SkillEscape)>) {
    let Some(root) = canon_root else {
        return (skills, Vec::new());
    };
    let mut kept = Vec::with_capacity(skills.len());
    let mut refused = Vec::new();
    for skill in skills {
        match skill_dir_escape(&skill.base_dir, root) {
            None => kept.push(skill),
            Some(reason) => refused.push((skill.name, reason)),
        }
    }
    (kept, refused)
}

/// Cap a path string for display on a char boundary, marking the cut in band.
fn capped_path_for_display(path: &std::path::Path) -> String {
    let mut s = path.to_string_lossy().into_owned();
    if s.len() > SKILL_ESCAPE_PATH_MAX_BYTES {
        let mut b = SKILL_ESCAPE_PATH_MAX_BYTES;
        while b > 0 && !s.is_char_boundary(b) { b -= 1; }
        let dropped = s.len() - b;
        s.truncate(b);
        s.push_str(&format!("… (+{dropped} bytes)"));
    }
    s
}
```

// === The `.yoyo/skills/` symlink-escape guard (#920, Day 205) ===
// The provenance gate above (#897) keys on the *directory* a project-local
// `.yoyo/skills/` occupies — "this project wrote it" — but a project-authored
// symlink inside that directory resolves somewhere else entirely, and the loader
// follows links (`Path::is_dir` and `Path::exists` both traverse them). Measured
// on Day 205: a scratch project whose `.yoyo/skills/escapee` was a symlink to a
// directory outside the project root loaded that skill, and the loaded
// `SKILL.md` path was the outside one. So the user's answer was about a
// directory, and the loaded body came from somewhere they were never shown.
//
// Direction rule: the *escaping* case is refused and the in-project symlink is
// NOT, because the predicate is "resolves outside this project", never "is a
// symlink". Refusing links wholesale would be a false positive that breaks a
// real workflow (a project that shares one skills dir across checkouts).

/// One `.yoyo/skills/` entry whose `SKILL.md` resolves outside the project root.
#[derive(Debug, Clone, PartialEq, Eq)]
pub(crate) struct EscapedSkillEntry {
    /// The entry's name as it appears in `.yoyo/skills/`.
    pub(crate) name: String,
    /// Where it actually resolves to.
    pub(crate) target: std::path::PathBuf,
}

/// Scan `dir` for skill entries that resolve outside `project_root`.
///
/// Empty when nothing escapes — which is every ordinary project, and the case
/// that must stay byte-identical. An unreadable entry, a broken link and a
/// directory without a `SKILL.md` are all skipped rather than guessed at: the
/// loader is about to apply the same predicate (`is_dir` + `SKILL.md` exists),
/// so anything it would not load cannot escape through it.
///
/// `project_root == None` (an unresolvable cwd) yields an EMPTY list rather than
/// a refusal, and that direction is a judgment, not an oversight: the predicate
/// is "escapes a root" and with no root there is nothing to have escaped from,
/// while refusing here would drop every project-local skill for a user whose cwd
/// vanished. The loud direction is preserved by the fact that such a run cannot
/// have found `.yoyo/skills/` by relative path in the first place.
pub(crate) fn escaped_skill_entries(
    dir: &std::path::Path,
    project_root: Option<&std::path::Path>,
) -> Vec<EscapedSkillEntry> {
    let Some(root) = project_root else {
        return Vec::new();
    };
    let Ok(root) = root.canonicalize() else {
        return Vec::new();
    };
    let Ok(entries) = std::fs::read_dir(dir) else {
        return Vec::new();
    };
    let mut escaped = Vec::new();
    for entry in entries.flatten() {
        let path = entry.path();
        if !path.is_dir() || !path.join("SKILL.md").is_file() {
            continue;
        }
        let Ok(resolved) = path.canonicalize() else {
            continue;
        };
        if !resolved.starts_with(&root) {
            escaped.push(EscapedSkillEntry {
                name: entry.file_name().to_string_lossy().to_string(),
                target: resolved,
            });
        }
    }
    escaped.sort_by(|a, b| a.name.cmp(&b.name));
    escaped
}
```


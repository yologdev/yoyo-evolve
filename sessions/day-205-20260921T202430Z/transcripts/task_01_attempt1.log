/// The stderr block shown when a project-local `.yoyo/skills/` contains an entry
/// that resolves outside the project.
pub(crate) fn escaped_skill_refusal_message(
    dir_label: &str,
    escaped: &[EscapedSkillEntry],
    plain: bool,
) -> String {
    let marker = if plain { "" } else { "⚠ " };
    let arrow = if plain { " -> " } else { " → " };
    let dash = if plain { ", " } else { " — " };
    let shown = escaped.len().min(SKILL_ESCAPE_LIST_MAX);
    let mut listed = escaped[..shown]...

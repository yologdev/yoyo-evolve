```rust
/// Load one auto-discovery source, refusing a project-local source that contains
/// an entry resolving outside the project root (#920).
///
/// `project_local` is true only for the `.yoyo/skills/` source; the caller passes
/// `source.label == PROJECT_SKILL_LABEL`, which is equivalent *because the
/// provenance gate has already removed that source from the list when the run is
/// untrusted* — anything still labelled `project` here is trusted and
/// project-local, so the same flag answers both questions.
///
/// Refusal is all-or-nothing for the source, and that blast radius is deliberate
/// rather than sloppy: the loader is upstream (`SkillSet::load_dir_resilient`)
/// and offers no per-entry filter, so the alternatives were "drop the one linked
/// entry" (impossible) or "drop nothing and let the body in" (the defect). The
/// message names every entry and the remedy, so the user is never left guessing
/// which skill vanished.
pub(crate) fn load_skill_source(
    dir: &std::path::Path,
    label: &str,
    project_local: bool,
) -> (yoagent::skills::SkillSet, Vec<yoagent::skills::SkillError>) {
    if !project_local {
        return yoagent::skills::SkillSet::load_dir_resilient(dir, label);
    }
    let root = std::env::current_dir().ok();
    let escaped = escaped_skill_entries(dir, root.as_deref());
    if !escaped.is_empty() {
        if !crate::format::is_quiet() {
            eprintln!(
                "{YELLOW}{}{RESET}",
                escaped_skill_refusal_message(&escaped, crate::format::is_plain_output())
            );
        }
        return (yoagent::skills::SkillSet::empty(), Vec::new());
    }
    yoagent::skills::SkillSet::load_dir_resilient(dir, label)
}
```


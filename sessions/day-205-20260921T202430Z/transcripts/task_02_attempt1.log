Design:

```rust
/// Environment variable that turns on restricted mode (#879 item 5).
///
/// The flag form is `--restricted`; this is the same switch read from the
/// environment so a wrapper script can export it once instead of rewriting
/// every invocation. Accepted true-ish spellings: `1` and `true`,
/// case-insensitive and trimmed — nothing else, so `YOYO_RESTRICTED=0`,
/// `=false`, `=""` and a misspelling all read **off** (absent means off; a
/// nonsense value must never turn a confinement on).
pub const RESTRICTED_ENV_VAR: &str = "YOYO_RESTRICTED";

/// The single decision for whether this run is restricted: flag OR env var.
///
/// Monotonic: neither source can turn the other off...
pub(crate) fn restricted_from_sources(flag: bool, env: Option<&str>) -> bool {
    flag || restricted_env_is_on(env)
}

fn restricted_env_is_on(env: Option<&str>) -> bool {
    match env {
        Some(v) => {
            let v = v.trim();
            v.eq_ignore_ascii_case("1") || v.eq_ignore_ascii_case("true")
        }
        None => false,
    }
}
```


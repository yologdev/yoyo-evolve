    /// "could not check" must not read as "checked; clean" — the standing rule,
    /// worded as `check_assertion_weakening.py`'s `could_not_check_message` is.
    fn audit_did_not_run_message(err: &str) -> String {
        format!(
            "PRICE AUDIT DID NOT RUN — the table is UNVERIFIED against models.dev, which is not the same as checked and clean.\n\
             fetch/parse failure: {err}\n\
             Fix the network or the fetch, then re-run: cargo test price_drift_audit -- --ignored"
        )

```rust
    fn fetch_models_dev_json() -> Result<String, String> {
        let out = std::process::Command::new("curl")
            .args(["--max-time", "60", "--fail", "--silent", "--show-error", MODELS_DEV_URL])
            .output()
            .map_err(|e| format!("curl could not be spawned: {e}"))?;
        if !out.status.success() {
            return Err(format!("curl exited {}: {}", out.status, String::from_utf8_lossy(&out.stderr).trim()));
        }
        Ok(String::from_utf8(out.stdout).map_err(|e| format!("curl output was not UTF-8: {e}"))?)
    }
```


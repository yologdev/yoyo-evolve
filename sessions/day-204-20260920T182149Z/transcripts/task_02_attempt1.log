```rust
    /// The audit's whole comparison, with the fetch removed: feed it the vendor's
    /// rows and it returns (mismatch lines, compared ids, registered-skipped ids).
    fn audit_vendor_rows(
        vendor: &[(String, f64, f64, f64)],
    ) -> (Vec<String>, Vec<String>, Vec<String>) {
        let registered: Vec<&str> = KNOWN_DIVERGENCES.iter().map(|(id, _)| *id).collect();
        let mut mismatches = Vec::new();
        let mut compared = Vec::new();
        let mut skipped = Vec::new();
        for (id, v_in, v_out, v_read) in vendor {
            if registered.contains(&id.as_str()) {
                skipped.push(id.clone());
                continue;
            }
            let Some((t_in, _t_write, t_read, t_out)) = model_pricing(id) else {
                continue;  // hmm - should this be visible?
            };
            compared.push(id.clone());
            if (t_in - v_in).abs() > EPS || (t_read - v_read).abs() > EPS || (t_out - v_out).abs() > EPS {
                mismatches.push(format!("{id}: table ({t_in}, {t_read}, {t_out}) vs models.dev ({v_in}, {v_read}, {v_out})"));
            }
        }
        (mismatches, compared, skipped)
    }
```


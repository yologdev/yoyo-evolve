def render_unread_vocabulary_names(names, cap=UNREAD_VOCABULARY_NAMES_CAP) -> str:
    """The second line of the skipped disclosure, or "" when there is nothing to name."""
    if not names:
        return ""
    shown = sorted(set(names))
    head = ", ".join(shown[:cap])
    if len(shown) > cap:
        head += f"  (+{len(shown) - cap} more elided)"
    return f"  names this vocabulary did not match: {head}"
```


Design:

```rust
/// The git instrument's decision, as a pure function of what the two git
/// probes returned. Separate from its I/O half on purpose (see
/// [`git_born_after_at`]) so the day-205 shape is a table row, not a
/// subprocess.
pub(crate) fn git_born_after_by_check(
    hash_resolves: bool,
    members: &[(String, bool)],   // (path, exists-at-that-tree)
) -> LedgerBornAfter {
    let mut out = LedgerBornAfter::default();
    if !hash_resolves {
        // The snapshot's own hash is not a commit we can check against, so the
        // check never ran for ANY member of this row: unmeasured, never
        // "after". The day-205 shape (dcc72f63) is exactly this.
        for (path, _) in members {
            out.unmeasured.push(path.clone());
        }
        return out;
    }
    for (path, exists) in members {
        if !exists {
            out.files.push(path.clone());
        }
    }
    out
}

/// I/O half. `git cat-file -t <hash>` first...
pub(crate) fn git_born_after_at(hash: &str, surprises: &[String]) -> LedgerBornAfter {
    let resolves = !hash.is_empty()
        && crate::git::run_git(&["cat-file", "-t", hash]).is_ok();
    let mut members: Vec<(String, bool)> = Vec::new();
    if resolves {
        for p in surprises {
            let exists = crate::git::run_git(&["cat-file", "-e", &format!("{hash}:{p}")]).is_ok();
            members.push((p.clone(), exists));
        }
    }
    git_born_after_by_check(resolves, &members)
}
```


Let me write `fix_loop_wall_split`:

```python
FIX_LOOP_WALL_TESTS = "touch tests/"
FIX_LOOP_WALL_SRC = "touch src/"
FIX_LOOP_WALL_ASSERTION = "assertion-shaped in src/"

def fix_loop_wall_split(rows, wall_of) -> dict:
    arm = [r for r in rows if r.population == POP_FIX_LOOP]
    counts = {
        "commits": len(arm),
        "tests": 0, "src": 0, "assertion_shaped": 0, "unreadable": 0,
    }
    for r in arm:
        facts = wall_of(r.sha)
        if facts is None:
            counts["unreadable"] += 1
            continue
        if facts.get("tests"): counts["tests"] += 1
        if facts.get("src"): counts["src"] += 1
        if facts.get("assertion_shaped"): counts["assertion_shaped"] += 1
    return counts
```


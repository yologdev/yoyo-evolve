Now the I/O half. Let me write it.

```python
FIX_LOOP_ASSERTION_MARKERS = ("#[test]", "cfg(test)", "assert")

def commit_fix_loop_wall_facts(root: str, sha: str):
    rc, out = run_cmd(["git", "-C", root, "diff", "--name-status", f"{sha}^", sha], timeout=60)
    if rc != 0:
        return None
    rows = parse_name_status(out)
    src_paths = [p for s, p in rows if p.startswith("src/") and p.endswith(".rs")]
    facts = {
        "tests": bool(top_level_test_files([p for s, p in rows])),
        "src": bool(src_paths),
        "assertion_shaped": False,
    }
    if facts["src"]:
        rc2, text = run_cmd(["git", "-C", root, "diff", "--unified=0", f"{sha}^", sha, "--", "src/"], timeout=60)
        if rc2 != 0:
            return None
        facts["assertion_shaped"] = diff_mentions_assertion_shape(text)
    return facts
```

Careful: `top_level_test_files` expects paths; it strips. Fine. But note `parse_name_status` returns both paths for renames — a rename of `tests/x.rs` yields both, fine.


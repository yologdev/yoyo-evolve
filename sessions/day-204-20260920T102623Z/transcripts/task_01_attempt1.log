```rust
/// Render a whole sequence of lines through one shared `HighlightState`, joined with
/// `\n` — the emission point a caller of `highlight_code_line_with` actually receives.
fn render_seq(lang: &str, lines: &[&str]) -> (String, HighlightState) {
    let mut st = HighlightState::default();
    let mut out = String::new();
    for (i, l) in lines.iter().enumerate() {
        if i > 0 { out.push('\n'); }
        out.push_str(&highlight_code_line_with(lang, l, &mut st));
    }
    (out, st)
}
```


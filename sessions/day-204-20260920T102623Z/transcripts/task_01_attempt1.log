//! Emission-point tests for the cross-line highlighter (#804).
//!
//! ...

use super::*;

/// Join per-line renders into one string so every assertion below is made on what a
/// sequence of lines actually emits, not on one line in isolation.
fn render_lines(lang: &str, lines: &[&str]) -> (String, HighlightState) {
    let mut st = HighlightState::default();
    let parts: Vec<String> = lines
        .iter()
        .map(|l| highlight_code_line_with(lang, l, &mut st))
        .collect();
    (parts.join("\n"), st)
}
```


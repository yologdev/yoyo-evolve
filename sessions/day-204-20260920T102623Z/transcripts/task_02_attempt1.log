```rust
/// Does the register name a *definition* (rather than a hand-inlined body)?
///
/// A definition occurrence's `context` **is its own name** — `scan_file` sets `current_fn`
/// to the name on the `fn` line before pushing — so a definition-shaped entry is one whose
/// context equals one of `helper_names()`. This is the predicate that lets the gate assert
/// the definitions register ships EMPTY ...
fn registers_a_definition(register: &[(&str, &str, &str)], names: &[String]) -> bool {
    register
        .iter()
        .any(|(_, context, _)| names.iter().any(|n| n == context))
}
```

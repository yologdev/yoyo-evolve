```rust
#[test]
fn the_definitions_register_is_empty_because_the_scan_finds_none() {
    let names = helper_names();
    // The register is the HAND-INLINED BODIES register; the definitions half of the rule
    // ships empty, which is its legitimate terminal state (#901's spec item 4).
    assert!(
        !registers_a_definition(REGISTERED_INLINE_BODIES, &names),
        "a definition-shaped entry is registered — the definitions register is no longer empty: ..."
    );
    // Anti-vacuous: the predicate must SEE a definition-shaped entry, or the assertion
    // above passes because the predicate never returns true for anything.
    for (p, c, r) in [
        ("src/fake.rs", "lock_or_recover", "why"),
        ("src/fake.rs", "rw_read_or_recover", "why"),
        ("src/fake.rs", "rw_write_or_recover", "why"),
    ] {
        assert!(registers_a_definition(&[(p, c, r)], &names), "predicate must see ({p}, {c})");
    }
    // Near-miss: a BODY-shaped entry (context is an ordinary fn name) must not read as one.
    for c in ["already_offered_file_persistence", "get", "lock_or_recover_twice"] {
        assert!(!registers_a_definition(&[("src/a.rs", c, "why")], &names), "body-shaped entry misread: {c}");
    }
}
```
